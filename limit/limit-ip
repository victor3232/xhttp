#!/bin/bash
# Auto Force IPv4
wget() { command wget -4 "$@"; }
curl() { command curl -4 "$@"; }
export -f wget curl 2>/dev/null || true
# Hybrid Xray IP-limit enforcer
# Supports Ubuntu 22/24/26 + Debian 12/13.
# Per-user limit files are authoritative: missing/0 = unlimited.
set -u

LOG=/var/log/xray/access.log
LOCK=/run/xray-limit-ip.lock

case "${1:-}" in
  vmip) MARK='###';  PROTO='vmess';       DB=/etc/vmess/.vmess.db;       DIR=/etc/kyt/limit/vmess/ip ;;
  vlip) MARK='#&';   PROTO='vless';       DB=/etc/vless/.vless.db;       DIR=/etc/kyt/limit/vless/ip ;;
  trip) MARK='#!';   PROTO='trojan';      DB=/etc/trojan/.trojan.db;     DIR=/etc/kyt/limit/trojan/ip ;;
  ssip) MARK='#!#';  PROTO='shadowsocks'; DB=/etc/shadowsocks/.shadowsocks.db; DIR=/etc/kyt/limit/shadowsocks/ip ;;
  *) exit 2 ;;
esac

[ -d "$DIR" ] || { while true; do sleep 600; done; }

send_log() {
    local user="$1" iplimit="$2" count="$3" action="${4:-account deleted}"
    local key chat url
    key=$(grep -E '^#bot# ' /etc/bot/.bot.db 2>/dev/null | tail -1 | awk '{print $2}')
    chat=$(grep -E '^#bot# ' /etc/bot/.bot.db 2>/dev/null | tail -1 | awk '{print $3}')
    if [ -z "$key" ] || [ -z "$chat" ]; then
        [ -f /usr/bin/kyt/var.txt ] || return 0
        [ -z "$key" ] && key=$(sed -n 's/^BOT_TOKEN=//p' /usr/bin/kyt/var.txt 2>/dev/null | tr -d "'\"\r\n ")
        [ -z "$chat" ] && chat=$(sed -n 's/^ADMIN=//p' /usr/bin/kyt/var.txt 2>/dev/null | tr -d "'\"\r\n ")
    fi
    [ -n "$key" ] && [ -n "$chat" ] || return 0
    url="https://api.telegram.org/bot${key}/sendMessage"
    curl -s --max-time 10 -d "chat_id=${chat}" \
      --data-urlencode "text=⚠️ XRAY MULTI LOGIN
Username: ${user}
Limit IP: ${iplimit}
Detected IP: ${count}
Action: ${action}" \
      "$url" >/dev/null 2>&1 || true
}

count_user_ips() {
    local user="$1" cutoff="$2"
    awk -v u="$user" -v cut="$cutoff" '
      function ip_of(s, n, a) {
        sub(/^[a-zA-Z]+:\/\//,"",s)
        if (s ~ /^\[/) {
          sub(/^\[/,"",s); sub(/\]:[0-9]+$/,"",s)
          return s
        }
        n=split(s,a,":")
        # IPv4:port has four dotted octets; IPv6 is preserved intact.
        if (s ~ /^[0-9.]+:[0-9]+$/) sub(/:[0-9]+$/,"",s)
        return s
      }
      ($1 " " $2) < cut { next }
      {
        account=""; src=""
        for (i=1;i<=NF;i++) if ($i=="email:" && i<NF) { account=$(i+1); break }
        if (account != u) next
        # Only authenticated/accepted connections count; failed/rejected requests do not.
        if ($0 !~ / accepted /) next
        # Xray access format: date time from IP:port accepted ...
        if ($3=="from") src=$4; else if ($4=="from") src=$5
        src=ip_of(src)
        if (src=="127.0.0.1" || src=="::1" || src=="::" || src=="0.0.0.0") next
        if (src!="") seen[src]=1
      }
      END { for (x in seen) print x }
    ' "$LOG" 2>/dev/null | sort -u
}

delete_user() {
    local user="$1" exp
    exec 9>"$LOCK"
    flock -x 9
    exp=$(awk -v m="$MARK" -v u="$user" '$1==m && $2==u {print $3; exit}' /etc/xray/config.json 2>/dev/null)
    [ -n "$exp" ] || { flock -u 9; return 0; }
    # Config is a marker line followed by the corresponding client object.
    sed -i "/^${MARK} ${user} ${exp}/,/^},{/d" /etc/xray/config.json
    [ -f "$DB" ] && sed -i "/^### ${user} /d" "$DB"
    rm -f "$DIR/$user"
    systemctl restart xray >/dev/null 2>&1 || true
    flock -u 9
}

while true; do
    sleep 60
    [ -r "$LOG" ] || continue
    [ -d "$DIR" ] || continue
    for file in "$DIR"/*; do
        [ -f "$file" ] || continue
        user=${file##*/}
        iplimit=$(tr -d '[:space:]' < "$file" 2>/dev/null)
        [[ "$iplimit" =~ ^[0-9]+$ ]] || continue
        [ "$iplimit" -gt 0 ] || continue
        # Already frozen by jeda-mullog: do not reset the timer.
        if [ -x /usr/local/sbin/jeda-mullog ] && /usr/local/sbin/jeda-mullog is-suspended xray "$PROTO" "$user" >/dev/null 2>&1; then
            continue
        fi
        # Ignore access-log entries from before the last restore. This prevents
        # an immediate re-suspend when the configured duration is < 10 minutes.
        _cut_epoch=$(date -d '10 minutes ago' +%s 2>/dev/null || date +%s)
        _last_restore=""
        [ -x /usr/local/sbin/jeda-mullog ] && _last_restore=$(/usr/local/sbin/jeda-mullog last-restore xray "$PROTO" "$user" 2>/dev/null)
        if [[ "$_last_restore" =~ ^[0-9]+$ ]] && [ "$_last_restore" -gt "$_cut_epoch" ]; then
            _cut_epoch="$_last_restore"
        fi
        cutoff=$(date -d "@$_cut_epoch" '+%Y/%m/%d %H:%M:%S' 2>/dev/null || date '+%Y/%m/%d %H:%M:%S')
        mapfile -t ips < <(count_user_ips "$user" "$cutoff")
        count=${#ips[@]}
        if [ "$count" -gt "$iplimit" ]; then
            _jeda_rc=2
            if [ -x /usr/local/sbin/jeda-mullog ]; then
                /usr/local/sbin/jeda-mullog suspend xray "$PROTO" "$user" "$iplimit" "$count" >/dev/null 2>&1
                _jeda_rc=$?
            fi
            if [ "$_jeda_rc" -eq 0 ] || [ "$_jeda_rc" -eq 3 ]; then
                # Engine suspends the account and sends the Telegram notification.
                :
            elif [ "$_jeda_rc" -eq 2 ]; then
                # Feature disabled / engine missing: keep the old delete behaviour.
                delete_user "$user"
                send_log "$user" "$iplimit" "$count" "account deleted"
            else
                # Do not delete accounts when suspension fails.
                send_log "$user" "$iplimit" "$count" "suspend failed - account kept"
            fi
        fi
    done
done
