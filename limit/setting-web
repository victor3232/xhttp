#!/bin/bash
# Setting Website VPNFree — ON/OFF dari menu Utility.
# ON  : pasang jika belum ada, lalu enable + start service.
# OFF : disable + stop service. Data /opt/kyt-web dan database TIDAK dihapus.
wget() { command wget -4 "$@"; }
curl() { command curl -4 "$@"; }
export -f wget curl 2>/dev/null || true

CONF="/etc/kyt-web.conf"
SERVICE="kyt-web"
APP="/opt/kyt-web/app.py"
REPO="${KYT_REPO:-https://scvpn.jolang323.workers.dev}"
ZIP_URL="${REPO%/}/web/web.zip"
FALLBACK="https://raw.githubusercontent.com/victor3232/xhttp/main/web/web.zip"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[0;33m'; NC=$'\033[0m'
B=$'\033[1m'

conf_get() {
    awk -F= -v k="$1" '$1==k {sub(/^[^=]*=/,""); print; exit}' "$CONF" 2>/dev/null
}
conf_set() {
    local key="$1" val="$2"
    touch "$CONF"
    if grep -qE "^${key}=" "$CONF" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${val}|" "$CONF"
    else
        printf '%s=%s\n' "$key" "$val" >> "$CONF"
    fi
}
ensure_conf() {
    [ -f "$CONF" ] || : > "$CONF"
    grep -qE '^ENABLED=' "$CONF" || echo 'ENABLED=0' >> "$CONF"
    grep -qE '^DOMAIN=' "$CONF" || echo 'DOMAIN=' >> "$CONF"
    chmod 644 "$CONF" 2>/dev/null
}
default_domain() {
    local base
    base=$(cat /etc/xray/domain 2>/dev/null | tr -d '\r\n')
    [ -n "$base" ] && echo "web.$base" || echo ""
}
server_ip() {
    local ip
    ip=$(curl -4 -sS --max-time 6 https://api.ipify.org 2>/dev/null | tr -d '[:space:]')
    [ -z "$ip" ] && ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    printf '%s' "$ip"
}
dns_ips() {
    getent ahostsv4 "$1" 2>/dev/null | awk '{print $1}' | sort -u
}
valid_domain() {
    [[ "$1" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$ ]]
}
turnstile_active() {
    [ "$(conf_get TURNSTILE_ENABLED)" = "1" ] && [ -n "$(conf_get TURNSTILE_SITE_KEY)" ] && [ -n "$(conf_get TURNSTILE_SECRET_KEY)" ]
}
server_line() {
    local db="/opt/kyt-web/data/web.db"
    [ -f "$db" ] || { printf '%s' "-"; return 0; }
    python3 - "$db" <<'SERVERPY' 2>/dev/null
import sqlite3, sys
c = sqlite3.connect(sys.argv[1])
data = dict(c.execute("select key,value from settings where key like 'server_%'"))
c.close()
code = (data.get("server_country_code") or "").strip().upper()
flag = "".join(chr(ord(ch) + 127397) for ch in code) if len(code) == 2 and code.isalpha() else "🌐"
name = (data.get("server_country_name") or "-").strip() or "-"
city = (data.get("server_city") or "").strip()
print(f"{flag} {name}" + (f" ({city})" if city else ""))
SERVERPY
}
turnstile_summary() {
    if turnstile_active; then
        local site
        site=$(conf_get TURNSTILE_SITE_KEY)
        printf 'AKTIF (site: %s...)' "${site:0:14}"
    else
        printf 'nonaktif'
    fi
}
turnstile_test_secret() {
    local secret resp
    secret=$(conf_get TURNSTILE_SECRET_KEY)
    if [ -z "$secret" ]; then
        echo -e "  ${YELLOW}Secret belum diatur.${NC}"; return 1
    fi
    echo "  Menguji secret ke Cloudflare..."
    resp=$(curl -4 -sS --max-time 25 -X POST \
        --data-urlencode "secret=$secret" \
        --data-urlencode "response=dummy-token-for-validation" \
        https://challenges.cloudflare.com/turnstile/v0/siteverify 2>/dev/null || true)
    if echo "$resp" | grep -q '"success":true'; then
        echo -e "  ${GREEN}Secret valid (test key selalu lolos).${NC}"
    elif echo "$resp" | grep -q 'invalid-input-response'; then
        echo -e "  ${GREEN}Secret valid.${NC} Token dummy ditolak seperti seharusnya."
    elif echo "$resp" | grep -q 'invalid-input-secret'; then
        echo -e "  ${RED}Secret TIDAK VALID.${NC} Periksa Secret Key di Cloudflare."
    else
        echo -e "  ${YELLOW}Tidak bisa memastikan otomatis.${NC}"
        echo "  Respons: ${resp:-kosong}"
    fi
}
rollback_domain() {
    local backup="$1" old="$2"
    echo -e "  ${YELLOW}Mengembalikan konfigurasi domain lama...${NC}"
    [ -f "$backup/kyt-web.conf" ] && cp -a "$backup/kyt-web.conf" "$CONF"
    [ -f "$backup/haproxy.cfg" ] && cp -a "$backup/haproxy.cfg" /etc/haproxy/haproxy.cfg
    [ -f "$backup/vpnfree.conf" ] && cp -a "$backup/vpnfree.conf" /etc/nginx/conf.d/vpnfree.conf
    [ -f "$backup/vpnfree.crt" ] && cp -a "$backup/vpnfree.crt" /etc/ssl/kyt-web/vpnfree.crt
    [ -f "$backup/vpnfree.key" ] && cp -a "$backup/vpnfree.key" /etc/ssl/kyt-web/vpnfree.key
    [ -f "$backup/vpnfree.pem" ] && cp -a "$backup/vpnfree.pem" /etc/haproxy/vpnfree.pem
    /usr/sbin/haproxy -c -f /etc/haproxy/haproxy.cfg >/dev/null 2>&1 && systemctl reload haproxy >/dev/null 2>&1
    nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1
    systemctl restart "$SERVICE" >/dev/null 2>&1
    echo -e "  ${GREEN}Rollback selesai.${NC} Domain kembali ke: ${old:-domain lama}"
}
is_installed() { [ -s "$APP" ] && [ -d /opt/kyt-web/static ] && [ -s /etc/systemd/system/kyt-web.service ]; }
is_active() { systemctl is-active --quiet "$SERVICE"; }

status_line() {
    ensure_conf
    local en dom act boot code
    en=$(conf_get ENABLED); dom=$(conf_get DOMAIN)
    act=$(systemctl is-active "$SERVICE" 2>/dev/null || true)
    boot=$(systemctl is-enabled "$SERVICE" 2>/dev/null || true)
    printf '  Status data   : %s\n' "${en:-0}"
    printf '  Service       : %s  (boot: %s)\n' "${act:-unknown}" "${boot:-unknown}"
    printf '  Domain        : %s\n' "${dom:--}"
    printf '  IP VPS        : %s\n' "$(server_ip)"
    printf '  Server        : %s\n' "$(server_line)"
    printf '  Turnstile     : %s\n' "$(turnstile_summary)"
    if [ -n "$dom" ]; then
        printf '  DNS resolve   : %s\n' "$(dns_ips "$dom" | tr '\n' ' ' | sed 's/ $//')"
        code=$(curl -k -sS --max-time 8 -o /dev/null -w '%{http_code}' "https://$dom/healthz" 2>/dev/null || true)
        printf '  Health HTTPS  : %s\n' "${code:-000}"
    fi
    printf '  Aplikasi      : %s\n' "$(is_installed && echo terpasang || echo belum terpasang)"
}

install_web() {
    local dom tmp pkg
    dom=$(conf_get DOMAIN)
    if [ -z "$dom" ]; then
        local def
        def=$(default_domain)
        read -rp "  Domain website${def:+ [$def]}: " dom
        [ -z "$dom" ] && dom="$def"
    fi
    if [ -z "$dom" ]; then
        echo -e "  ${RED}Domain wajib diisi.${NC}"
        return 1
    fi
    echo -e "  ${YELLOW}Website belum terpasang. Mengunduh paket web.zip...${NC}"
    tmp=$(mktemp -d /tmp/kyt-web-install.XXXXXX)
    if ! curl -fsSL --max-time 120 -o "$tmp/web.zip" "${ZIP_URL}?v=$(date +%s)" 2>/dev/null; then
        wget -q --timeout=60 -O "$tmp/web.zip" "$FALLBACK" 2>/dev/null || true
    fi
    if [ ! -s "$tmp/web.zip" ]; then
        echo -e "  ${RED}Gagal mengunduh web.zip.${NC}"
        rm -rf "$tmp"; return 1
    fi
    mkdir -p "$tmp/pkg"
    if ! unzip -oq "$tmp/web.zip" -d "$tmp/pkg" 2>/dev/null; then
        echo -e "  ${RED}web.zip rusak / gagal diekstrak.${NC}"
        rm -rf "$tmp"; return 1
    fi
    # Dukung dua gaya arsip: file di root atau di dalam folder web/.
    pkg="$tmp/pkg"
    if [ ! -f "$pkg/install.sh" ] && [ -f "$pkg/web/install.sh" ]; then
        pkg="$pkg/web"
    fi
    if [ ! -f "$pkg/install.sh" ]; then
        echo -e "  ${RED}install.sh tidak ditemukan di dalam web.zip.${NC}"
        rm -rf "$tmp"; return 1
    fi
    if ! bash "$pkg/install.sh" "$dom"; then
        echo -e "  ${RED}Instalasi website gagal.${NC}"
        rm -rf "$tmp"; return 1
    fi
    conf_set DOMAIN "$dom"
    rm -rf "$tmp"
}

turn_on() {
    ensure_conf
    if ! is_installed; then
        install_web || return 1
    fi
    if [ -z "$(conf_get DOMAIN)" ]; then
        local def dom
        def=$(default_domain)
        read -rp "  Domain website${def:+ [$def]}: " dom
        [ -z "$dom" ] && dom="$def"
        if [ -z "$dom" ]; then
            echo -e "  ${RED}Domain wajib diisi.${NC}"
            return 1
        fi
        conf_set DOMAIN "$dom"
    fi
    systemctl daemon-reload >/dev/null 2>&1
    systemctl enable "$SERVICE" >/dev/null 2>&1
    systemctl start "$SERVICE" >/dev/null 2>&1
    sleep 2
    if is_active; then
        conf_set ENABLED 1
        echo -e "  ${GREEN}Website ON.${NC} Service $SERVICE aktif."
        return 0
    fi
    echo -e "  ${RED}Website gagal start. Cek: journalctl -u $SERVICE -n 30${NC}"
    return 1
}

turn_off() {
    ensure_conf
    systemctl disable --now "$SERVICE" >/dev/null 2>&1
    conf_set ENABLED 0
    echo -e "  ${YELLOW}Website OFF.${NC} Service dihentikan; data dan database tetap disimpan."
}

test_access() {
    ensure_conf
    local dom code
    dom=$(conf_get DOMAIN)
    if [ -z "$dom" ]; then
        echo -e "  ${YELLOW}Domain belum diatur.${NC}"; return 1
    fi
    code=$(curl -k -sS --max-time 10 -o /dev/null -w '%{http_code}' "https://$dom/healthz" 2>/dev/null || true)
    echo "  https://$dom  -> HTTP ${code:-000}"
}

turnstile_setup() {
    ensure_conf
    local site="${1:-}" secret="${2:-}" resp answer code dom
    clear
    echo -e "${B}=========================================================${NC}"
    echo -e "           ${B}CLOUDFLARE TURNSTILE${NC}"
    echo -e "${B}=========================================================${NC}"
    echo "  Status saat ini : $(turnstile_summary)"
    echo "  Site Key   = dipasang di widget website."
    echo "  Secret Key = disimpan di server, jangan dibagikan."
    echo -e "${B}=========================================================${NC}"
    if [ -z "$site" ]; then
        read -rp "  Site Key   : " site
    fi
    if [ -z "$secret" ]; then
        read -rp "  Secret Key : " secret
    fi
    site=$(printf '%s' "$site" | tr -d '[:space:]')
    secret=$(printf '%s' "$secret" | tr -d '[:space:]')
    if [ -z "$site" ] || [ -z "$secret" ]; then
        echo -e "  ${RED}Site Key dan Secret Key wajib diisi.${NC}"; return 1
    fi
    if ! [[ "$site" =~ ^0x4[A-Za-z0-9_-]{10,}$ ]]; then
        echo -e "  ${RED}Format Site Key tidak valid.${NC}"; return 1
    fi
    if ! [[ "$secret" =~ ^0x4[A-Za-z0-9_-]{10,}$ ]]; then
        echo -e "  ${RED}Format Secret Key tidak valid.${NC}"; return 1
    fi

    echo "  Memvalidasi Secret Key ke Cloudflare..."
    resp=$(curl -4 -sS --max-time 25 -X POST \
        --data-urlencode "secret=$secret" \
        --data-urlencode "response=dummy-token-for-validation" \
        https://challenges.cloudflare.com/turnstile/v0/siteverify 2>/dev/null || true)
    if echo "$resp" | grep -q 'invalid-input-secret'; then
        echo -e "  ${RED}Secret Key ditolak Cloudflare.${NC}"
        echo "  Pastikan Anda memasukkan Secret Key, bukan Site Key."
        return 1
    elif echo "$resp" | grep -q 'invalid-input-response'; then
        echo -e "  ${GREEN}Secret Key valid.${NC}"
    elif echo "$resp" | grep -q '"success":true'; then
        echo -e "  ${GREEN}Secret Key valid (test key).${NC}"
    else
        echo -e "  ${YELLOW}Tidak bisa memvalidasi otomatis (jaringan/gateway).${NC}"
        echo "  Respons: ${resp:-kosong}"
        read -rp "  Simpan tetap? [y/N]: " answer
        case "$answer" in y|Y|ya|YA) ;; *) echo -e "  ${YELLOW}Dibatalkan.${NC}"; return 1 ;; esac
    fi

    conf_set TURNSTILE_ENABLED 1
    conf_set TURNSTILE_SITE_KEY "$site"
    conf_set TURNSTILE_SECRET_KEY "$secret"
    echo "  Menyimpan dan me-restart website..."
    systemctl restart "$SERVICE" >/dev/null 2>&1
    sleep 2
    dom=$(conf_get DOMAIN)
    code=$(curl -k -sS --max-time 12 -o /dev/null -w '%{http_code}' "https://$dom/healthz" 2>/dev/null || true)
    if [ "$code" = "200" ]; then
        echo -e "  ${GREEN}Turnstile aktif.${NC} Website: https://$dom"
    else
        echo -e "  ${YELLOW}Kunci tersimpan, tetapi health HTTPS = ${code:-000}.${NC}"
        echo "  Cek: systemctl status $SERVICE --no-pager"
    fi
}

turnstile_disable() {
    ensure_conf
    conf_set TURNSTILE_ENABLED 0
    systemctl restart "$SERVICE" >/dev/null 2>&1
    echo -e "  ${YELLOW}Turnstile dinonaktifkan.${NC}"
}

turnstile_menu() {
    while true; do
        clear
        echo -e "${B}=========================================================${NC}"
        echo -e "           ${B}CLOUDFLARE TURNSTILE${NC}"
        echo -e "${B}=========================================================${NC}"
        echo "  Status        : $(turnstile_summary)"
        echo "  Site Key      : $(conf_get TURNSTILE_SITE_KEY)"
        echo "  Secret Key    : $(if [ -n "$(conf_get TURNSTILE_SECRET_KEY)" ]; then echo 'tersimpan (disamarkan)'; else echo '-'; fi)"
        echo -e "${B}=========================================================${NC}"
        echo "  1) Pasang / ubah Site Key & Secret Key"
        echo "  2) Nonaktifkan Turnstile"
        echo "  3) Tes Secret Key"
        echo "  0) Kembali"
        echo -e "${B}=========================================================${NC}"
        read -rp "  Pilih [0-3]: " answer
        case "$answer" in
            1) turnstile_setup; read -rp "  Enter..." _ ;;
            2) turnstile_disable; read -rp "  Enter..." _ ;;
            3) turnstile_test_secret; read -rp "  Enter..." _ ;;
            0) return 0 ;;
            *) ;;
        esac
    done
}

change_domain() {
    ensure_conf
    local old dom ip resolved answer stamp backup challenge code
    old=$(conf_get DOMAIN)
    ip=$(server_ip)
    clear
    echo -e "${B}=========================================================${NC}"
    echo -e "              ${B}GANTI DOMAIN / SUBDOMAIN${NC}"
    echo -e "${B}=========================================================${NC}"
    echo "  Domain aktif : ${old:--}"
    echo "  IP VPS       : ${ip:--}"
    echo -e "${B}=========================================================${NC}"
    echo -e "  ${RED}WAJIB POINTING DNS TERLEBIH DAHULU.${NC}"
    echo "  Sebelum lanjut, buat DNS A record:"
    echo -e "      ${B}<domain-baru>  ->  ${ip}${NC}"
    echo "  Tunggu propagasi 1-10 menit. Jika memakai Cloudflare,"
    echo "  origin harus VPS ini dan mode SSL minimal Full."
    echo "  Jika DNS belum mengarah, proses akan dibatalkan otomatis."
    echo -e "${B}=========================================================${NC}"
    read -rp "  Domain/subdomain baru (contoh: hits.domain.com): " dom
    dom=$(printf '%s' "$dom" | tr 'A-Z' 'a-z' | tr -d '[:space:]')
    if [ -z "$dom" ]; then
        echo -e "  ${YELLOW}Dibatalkan.${NC}"; return 1
    fi
    if ! valid_domain "$dom"; then
        echo -e "  ${RED}Format domain tidak valid:${NC} $dom"
        return 1
    fi
    if [ "$dom" = "$old" ]; then
        echo -e "  ${YELLOW}Domain sama dengan yang aktif.${NC}"; return 1
    fi
    read -rp "  Ketik POINTING jika DNS sudah diarahkan: " answer
    if [ "$answer" != "POINTING" ]; then
        echo -e "  ${YELLOW}Dibatalkan. Tidak ada perubahan.${NC}"; return 1
    fi

    resolved=$(dns_ips "$dom" | tr '\n' ' ' | sed 's/ $//')
    if [ -z "$resolved" ]; then
        echo -e "  ${RED}DNS $dom belum resolve.${NC}"
        echo "  Buat A record ke $ip lalu coba lagi."
        return 1
    fi
    echo "  Resolve DNS  : $resolved"
    if ! dns_ips "$dom" | grep -qx "$ip"; then
        echo -e "  ${YELLOW}Peringatan: IP resolve bukan $ip.${NC}"
        echo "  Ini normal jika memakai Cloudflare/proxy. Pastikan origin tetap VPS ini."
        read -rp "  Lanjutkan? [y/N]: " answer
        case "$answer" in
            y|Y|ya|YA) ;;
            *) echo -e "  ${YELLOW}Dibatalkan.${NC}"; return 1 ;;
        esac
    fi

    stamp=$(date +%Y%m%d-%H%M%S)
    backup="/root/kyt-web-domain-backup-$stamp"
    mkdir -p "$backup"
    cp -a "$CONF" "$backup/kyt-web.conf" 2>/dev/null || true
    cp -a /etc/haproxy/haproxy.cfg "$backup/haproxy.cfg" 2>/dev/null || true
    cp -a /etc/nginx/conf.d/vpnfree.conf "$backup/vpnfree.conf" 2>/dev/null || true
    cp -a /etc/ssl/kyt-web/vpnfree.crt "$backup/vpnfree.crt" 2>/dev/null || true
    cp -a /etc/ssl/kyt-web/vpnfree.key "$backup/vpnfree.key" 2>/dev/null || true
    cp -a /etc/haproxy/vpnfree.pem "$backup/vpnfree.pem" 2>/dev/null || true

    echo "  Menerapkan domain sementara..."
    conf_set DOMAIN "$dom"
    if ! python3 /usr/local/sbin/kyt-web-configure-edge "$dom"; then
        echo -e "  ${RED}Gagal memasang edge untuk $dom.${NC}"
        rollback_domain "$backup" "$old"
        return 1
    fi

    mkdir -p /var/www/letsencrypt/.well-known/acme-challenge
    printf 'kyt-domain-check' > /var/www/letsencrypt/.well-known/acme-challenge/kyt-domain-check
    challenge=$(curl -4 -fsSL --max-time 25 "http://$dom/.well-known/acme-challenge/kyt-domain-check" 2>/dev/null | tr -d '\r\n')
    rm -f /var/www/letsencrypt/.well-known/acme-challenge/kyt-domain-check
    if [ "$challenge" != "kyt-domain-check" ]; then
        echo -e "  ${RED}Verifikasi HTTP gagal.${NC}"
        echo "  Domain belum mengarah ke VPS ini, atau port 80 terblokir."
        echo "  Jika memakai Cloudflare, matikan sementara Always Use HTTPS / proxy."
        rollback_domain "$backup" "$old"
        return 1
    fi

    echo "  DNS + HTTP OK. Menerbitkan sertifikat Let's Encrypt..."
    if ! /usr/local/sbin/issue-cert.sh "$dom"; then
        echo -e "  ${RED}Sertifikat gagal diterbitkan.${NC}"
        rollback_domain "$backup" "$old"
        return 1
    fi

    systemctl restart "$SERVICE" >/dev/null 2>&1
    sleep 2
    code=$(curl -k -sS --max-time 12 -o /dev/null -w '%{http_code}' "https://$dom/healthz" 2>/dev/null || true)
    if [ "$code" != "200" ]; then
        echo -e "  ${RED}Health HTTPS gagal (${code:-000}).${NC}"
        rollback_domain "$backup" "$old"
        return 1
    fi

    printf "HITS SSH admin\nURL    : https://%s/admin\nLogin  : token bot Telegram\nToken  : awk '/^#bot# /{print \$2}' /etc/bot/.bot.db\n" "$dom" > /root/kyt-web-admin.txt
    chmod 600 /root/kyt-web-admin.txt 2>/dev/null || true
    echo -e "  ${GREEN}Domain berhasil diganti.${NC}"
    echo "  Website baru : https://$dom"
    echo "  Admin baru   : https://$dom/admin"
    echo "  Backup       : $backup"
    return 0
}

interactive() {
    while true; do
        clear
        echo -e "${B}=========================================================${NC}"
        echo -e "                 ${B}SETTING WEBSITE${NC}"
        echo -e "${B}=========================================================${NC}"
        status_line
        echo -e "${B}=========================================================${NC}"
        echo "  1) ON  — install jika perlu, lalu jalankan website"
        echo "  2) OFF — stop + disable, data tetap aman"
        echo "  3) Tes akses domain"
        echo "  4) Ganti domain / subdomain (wajib pointing DNS)"
        echo "  5) Cloudflare Turnstile (site key & secret)"
        echo "  0) Kembali"
        echo -e "${B}=========================================================${NC}"
        read -rp "  Pilih [0-5]: " p
        case "$p" in
            1) turn_on; read -rp "  Enter..." _ ;;
            2) turn_off; read -rp "  Enter..." _ ;;
            3) test_access; read -rp "  Enter..." _ ;;
            4) change_domain; read -rp "  Enter..." _ ;;
            5) turnstile_menu ;;
            0) return 0 ;;
            *) ;;
        esac
    done
}

ensure_conf
case "${1:-}" in
    on|ON|1) turn_on ;;
    off|OFF|0|2) turn_off ;;
    status) status_line ;;
    test) test_access ;;
    domain|DOMAIN|4) change_domain ;;
    turnstile|TURNSTILE|5) turnstile_menu ;;
    turnstile-set) shift; turnstile_setup "${1:-}" "${2:-}" ;;
    "" ) interactive ;;
    *) echo "Usage: setting-web [on|off|status|test|domain|turnstile|turnstile-set SITE SECRET]"; exit 64 ;;
esac
