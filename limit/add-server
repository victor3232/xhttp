#!/bin/bash
# ============================================================
#  ADD SERVER — pasang agent node di VPS cabang
#  Menu Utility → 28
#
#  Alur simpel:
#    1. Jalankan menu ini di VPS baru (setelah autoscript + domain/SSL)
#    2. Catat URL agent, API Key, dan Secret
#    3. Tempel ketiganya di web utama → Multi-Server → Add Server
#    4. Selesai. Tidak perlu mengatur IP VPS utama.
# ============================================================
set -uo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

REPO="${KYT_REPO:-victor3232/xhttp}"
INSTALL_URL="https://raw.githubusercontent.com/${REPO}/main/node/install-node.sh"
CONF="/etc/kyt-node/agent.json"

pause() {
    read -r -n 1 -s -p " Tekan Enter untuk kembali..." _ || true
    echo
}

die() {
    echo
    echo -e "${RED}[ERROR]${NC} $*"
    pause
    exit 1
}

clear
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "                 ${BOLD}ADD SERVER${NC}"
echo -e "        Pasang agent di VPS cabang (node)"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo

MYIP=$(curl -4 -sS --max-time 5 https://ipv4.icanhazip.com 2>/dev/null || true)
if [ -z "$MYIP" ]; then
    MYIP=$(hostname -I 2>/dev/null | awk '{print $1}')
fi

# ------------------------------------------------------------
# Sudah terpasang? Tampilkan credential yang ada.
# ------------------------------------------------------------
if [ -s "$CONF" ]; then
    echo -e "${GREEN}Agent node sudah terpasang di VPS ini.${NC}"
    echo
    python3 - "$CONF" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception as exc:
    print("Gagal membaca config:", exc)
    raise SystemExit(0)
domain = d.get("domain") or ""
if not domain:
    try:
        domain = open("/etc/xray/domain").read().strip()
    except Exception:
        domain = "<domain>"
print("  URL agent : https://%s:%s" % (domain, d.get("port") or 8787))
print("  Node code : %s" % (d.get("node") or "-"))
print("  API Key   : %s" % (d.get("api_key") or "-"))
print("  Secret    : %s" % (d.get("secret") or "-"))
print("  Revoked   : %s" % bool(d.get("revoked")))
PY
    echo
    echo -e "${YELLOW}Tempel ketiga nilai di atas ke web utama: Admin → Multi-Server → Add Server.${NC}"
    echo -e "Ingin secret baru? Jalankan: ${BOLD}kyt-node rotate${NC}"
    echo "Setelah rotate, perbarui Secret lewat menu Koneksi Agent di web."
    pause
    exit 0
fi

# ------------------------------------------------------------
# Jangan jalankan di VPS utama (master).
# ------------------------------------------------------------
if [ -f /opt/kyt-web/app.py ] || systemctl list-unit-files --no-legend kyt-web.service 2>/dev/null | grep -q .; then
    echo -e "${YELLOW}VPS ini terdeteksi sebagai VPS utama (ada panel web).${NC}"
    echo "Add Server hanya dijalankan di VPS cabang."
    echo "Di VPS utama, cukup tambah node lewat Admin → Multi-Server → Add Server."
    pause
    exit 0
fi

# ------------------------------------------------------------
# Prasyarat autoscript VPN.
# ------------------------------------------------------------
echo -e "${CYAN}[1/4] Cek prasyarat autoscript VPN...${NC}"
MISSING=0
for f in /etc/xray/xray.crt /etc/xray/xray.key \
         /usr/local/sbin/addssh /usr/local/sbin/addws \
         /usr/local/sbin/addvless /usr/local/sbin/addtr; do
    if [ ! -e "$f" ]; then
        echo -e "  ${RED}✗${NC} $f tidak ditemukan"
        MISSING=1
    fi
done
if [ "$MISSING" -ne 0 ]; then
    echo
    echo -e "${RED}Autoscript VPN belum lengkap.${NC}"
    echo "Pasang autoscript + domain/SSL di VPS ini dulu, lalu ulangi Add Server."
    pause
    exit 1
fi
echo -e "  ${GREEN}✓${NC} Sertifikat & script VPN tersedia"

DOMAIN_DEFAULT=$(cat /etc/xray/domain 2>/dev/null | tr -d '\r\n' || true)

# ------------------------------------------------------------
# Input data node. Tidak ada pertanyaan IP VPS utama.
# ------------------------------------------------------------
echo
echo -e "${CYAN}[2/4] Data node${NC}"
if [ -n "$DOMAIN_DEFAULT" ]; then
    read -r -p "  Domain VPS ini [$DOMAIN_DEFAULT]: " DOMAIN
    DOMAIN="${DOMAIN:-$DOMAIN_DEFAULT}"
else
    read -r -p "  Domain VPS ini (contoh node.domain.com): " DOMAIN
fi

read -r -p "  Port agent [8787]: " PORT
PORT="${PORT:-8787}"

read -r -p "  Maks slot akun [50]: " SLOTS
SLOTS="${SLOTS:-50}"

[ -n "$DOMAIN" ] || die "Domain VPS ini wajib diisi."
[[ "$PORT" =~ ^[0-9]+$ ]] && [ "$PORT" -ge 1024 ] && [ "$PORT" -le 65535 ] \
    || die "Port harus 1024-65535."
[[ "$SLOTS" =~ ^[0-9]+$ ]] || die "Maks slot harus angka."

echo
echo -e "${CYAN}Ringkasan:${NC}"
echo "  VPS ini       : ${MYIP:-?} ($DOMAIN)"
echo "  Port agent    : $PORT"
echo "  Maks slot     : $SLOTS"
echo "  IP master     : otomatis (tidak perlu diisi)"
echo
read -r -p "Lanjut pasang agent? [Y/n]: " CONFIRM
case "${CONFIRM:-Y}" in
    [yY]*) ;;
    *) echo "Dibatalkan."; pause; exit 0 ;;
esac

# ------------------------------------------------------------
# Unduh & jalankan installer node.
# ------------------------------------------------------------
echo
echo -e "${CYAN}[3/4] Memasang agent node...${NC}"
command -v curl >/dev/null 2>&1 || die "curl tidak ditemukan. Install curl dulu."
TMP="$(mktemp /tmp/kyt-node-install.XXXXXX.sh)"
if ! curl -4 -fsSL --max-time 60 "$INSTALL_URL" -o "$TMP"; then
    rm -f "$TMP"
    die "Gagal mengunduh installer dari repo. Cek koneksi internet VPS."
fi
bash "$TMP" --domain "$DOMAIN" --code "tmp-1" \
    --port "$PORT" --max-slots "$SLOTS"
RC=$?
rm -f "$TMP"
if [ "$RC" -ne 0 ]; then
    die "Installer gagal (exit $RC). Cek: journalctl -u kyt-node-agent -n 50 --no-pager"
fi
if [ ! -s "$CONF" ]; then
    die "Agent terpasang tetapi config tidak ditemukan."
fi

# ------------------------------------------------------------
# Tampilkan credential final.
# ------------------------------------------------------------
echo
echo -e "${CYAN}[4/4] Selesai. Credential untuk web utama:${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
python3 - "$CONF" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
domain = d.get("domain") or open("/etc/xray/domain").read().strip()
print("  URL agent : https://%s:%s" % (domain, d.get("port") or 8787))
print("  API Key   : %s" % d.get("api_key"))
print("  Secret    : %s" % d.get("secret"))
print("  Node code : %s (kode final diisi otomatis oleh web)" % d.get("node"))
PY
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo
echo -e "${BOLD}Langkah berikutnya di web utama:${NC}"
echo "  1. Login Admin"
echo "  2. Multi-Server → Add Server"
echo "  3. Tempel URL agent, API Key, dan Secret di atas"
echo "  4. Klik Tambah, lalu Tes"
echo
echo -e "${YELLOW}Simpan Secret ini. Siapa pun yang punya Secret bisa mengontrol node.${NC}"
echo -e "${GREEN}Agent memakai API Key + HMAC. Tidak ada patokan IP VPS utama.${NC}"
pause
