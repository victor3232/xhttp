#!/bin/bash
clear
RED='\033[0;31m'
NC='\e[0m'
gray="\e[1;30m"
Blue="\033[0;37m"
GREEN="\033[0;37m"

BGX="\033[42m"
UPDATE="https://scvpn.jolang323.workers.dev/"
#BOT="https://raw.githubusercontent.com/myridwan/src/ipuk/"
UDPCORE="${UPDATE}limit/install-udp.sh"
clear
# ===== UI SUBMENU (THEMED) =====
THEME=$(grep -E '^THEME=' /etc/kyt-theme.conf 2>/dev/null | cut -d= -f2 | tr -d ' ' | tr 'a-z' 'A-Z')
case "$THEME" in
  RED)    SB=$'\033[38;2;185;28;28m';  ST=$'\033[38;2;248;113;113m'; SN=$'\033[38;2;252;165;165m'; SBG=$'\033[48;2;127;29;29m';;
  BLUE)   SB=$'\033[38;2;29;78;216m';  ST=$'\033[38;2;96;165;250m';  SN=$'\033[38;2;147;197;253m'; SBG=$'\033[48;2;30;64;175m';;
  CYAN)   SB=$'\033[38;2;8;145;178m';   ST=$'\033[38;2;34;211;238m';  SN=$'\033[38;2;103;232;249m'; SBG=$'\033[48;2;22;101;120m';;
  GREEN)  SB=$'\033[38;2;21;128;61m';   ST=$'\033[38;2;74;222;128m';  SN=$'\033[38;2;134;239;172m'; SBG=$'\033[48;2;22;101;52m';;
  PURPLE) SB=$'\033[38;2;126;34;206m';  ST=$'\033[38;2;192;132;252m'; SN=$'\033[38;2;216;180;254m'; SBG=$'\033[48;2;88;28;135m';;
  PINK)   SB=$'\033[38;2;190;24;93m';   ST=$'\033[38;2;244;114;182m'; SN=$'\033[38;2;249;168;212m'; SBG=$'\033[48;2;131;24;67m';;
  WHITE)  SB=$'\033[37m';              ST=$'\033[97m';              SN=$'\033[97m';              SBG=$'\033[100m';;
  *)      SB=$'\033[38;2;204;153;0m';  ST=$'\033[38;2;255;191;36m';  SN=$'\033[38;2;253;224;71m';  SBG=$'\033[48;2;153;115;0m';;
esac
SX=$'\033[38;2;243;244;246m'
SR=$'\033[0m'
SLINE=$(printf '━%.0s' $(seq 1 57))
sline() { printf ' %s%s%s\n' "$SB" "$SLINE" "$SR"; }
sbar() { local t="$1" w=57 p r; p=$(( (w - ${#t}) / 2 )); r=$(( w - p - ${#t} )); printf ' %s%*s%s%s%*s%s\n' "$SBG" "$p" '' "$ST" "$t" "$r" '' "$SR"; }
sopt2() { printf '  %s%2s.)%s %s%-21.21s%s' "$SN" "$1" "$SR" "$SX" "$2" "$SR"; }
sline
sbar "MENU TAMBAHAN"
sline
echo -e " $(sopt2 1 "CEK RUNNING SERVICE")$(sopt2 11 "BCKUP & RESTORE BOT")"
echo -e " $(sopt2 2 "INSTALL UDP")$(sopt2 12 "DELL ALL EXP")"
echo -e " $(sopt2 3 "ADD BOT TELEGRAM")$(sopt2 13 "ADD BOT NOTIFIKASI")"
echo -e " $(sopt2 4 "UPDATE SCRIPT")$(sopt2 14 "MONITOR")"
echo -e " $(sopt2 5 "RESTART SERVICE")$(sopt2 15 "INSTALL DNS NONTON")"
echo -e " $(sopt2 6 "GANTI BANNER")$(sopt2 16 "INSTALL PANEL")"
echo -e " $(sopt2 7 "GANTI DOMAIN")$(sopt2 17 "SPEEDTEST")"
echo -e " $(sopt2 8 "FIX POINTING DOMAIN")$(sopt2 18 "AUTO REBOOT")"
echo -e " $(sopt2 9 "CLEAR LOGS")$(sopt2 19 "INFO PORT")"
echo -e " $(sopt2 10 "CLEAR CACHE")$(sopt2 20 "FIX / RESTART HAPROXY")"
echo -e " $(sopt2 21 "GANTI TEMA WARNA UI")$(sopt2 22 "CHECK BANDWIDTH")"
echo -e " $(sopt2 23 "LIMIT SPEED")$(sopt2 24 "GANTI NS / SLOWDNS")"
echo -e " $(sopt2 25 "TIMER MULLOG")"
sline
echo -e " $(sopt2 0 "Back To Menu")"
sline
printf '\n'
printf ' %sSelect From Options %s[1-25 / 0]%s : %s' "$SN" "$SB" "$SN" "$SR"
read -r menu
case $menu in
1) clear ;
    run
    ;;
2) clear ;
    wget -4 -q -O install-udp "${UDPCORE}" && chmod +x install-udp && ./install-udp
    ;;
3) clear ;
    add-bot-panel
    ;;    
4) clear ;   
    wget -4 ${UPDATE}update.sh && chmod +x update.sh && ./update.sh
    ;;
5) clear ;    
    reset
    ;;
6) clear ;   
    nano /etc/kyt.txt
    ;;
7) clear ; 
    addhost
    ;;
8) clear ;
   fixcert
   ;;
9) clear ;
   clearlog
   ;;
10) clear ;
   clearcache
   ;;
11) clear ;
   mbot
   ;;
12) clear ;
   xp
    ;;
13) clear ;
   bot
   ;;
14) clear ;
   gotop
   ;;
15) clear ;
   wget https://raw.githubusercontent.com/Jengkolonline/nonton/main/nf.sh && chmod +x nf.sh && ./nf.sh
   ;;
16) clear ;
   m-panel
   ;;
17) clear ;
   speedtest
   ;;      
18) clear ;
   autoreboot
   ;;  
19) clear ;
   prot
   ;;    
20) clear ;
   fix-haproxy
   ;;    
21) clear ;
   ganti-tema
   ;;
22) clear ;
   bw
   ;;
23) clear ;
   limitspeed
   ;;
24) clear ;
   ganti-ns
   ;;
25) clear ;
   setting-jeda
   ;;
0) clear ;
   menu
   ;;
*) clear ;
    menu
    ;;
esac
