#!/bin/bash
# Auto Force IPv4
wget() { command wget -4 "$@"; }
curl() { command curl -4 "$@"; }
export -f wget curl 2>/dev/null || true
# Hybrid SSH multi-login limiter.
# Debian 11/12/13 + Ubuntu 22/24/26; sshd, sshd-session and Dropbear.
# Action: temporary suspend (jeda-mullog) or kill sessions if disabled.
set -u

LOG=/var/log/auth.log
[ -r /var/log/secure ] && LOG=/var/log/secure
DIR=/etc/kyt/limit/ssh/ip
LOCK=/run/ssh-limit.lock

send_log() {
    local user="$1" limit="$2" count="$3" ips="$4" action="${5:-sessions killed}" key chat
    key=$(grep -E '^#bot# ' /etc/bot/.bot.db 2>/dev/null | tail -1 | awk '{print $2}')
    chat=$(grep -E '^#bot# ' /etc/bot/.bot.db 2>/dev/null | tail -1 | awk '{print $3}')
    if [ -z "$key" ] || [ -z "$chat" ]; then
        [ -f /usr/bin/kyt/var.txt ] || return 0
        [ -z "$key" ] && key=$(sed -n 's/^BOT_TOKEN=//p' /usr/bin/kyt/var.txt 2>/dev/null | tr -d "'\"\r\n ")
        [ -z "$chat" ] && chat=$(sed -n 's/^ADMIN=//p' /usr/bin/kyt/var.txt 2>/dev/null | tr -d "'\"\r\n ")
    fi
    [ -n "$key" ] && [ -n "$chat" ] || return 0
    curl -s --max-time 10 "https://api.telegram.org/bot${key}/sendMessage" \
      --data-urlencode "chat_id=${chat}" \
      --data-urlencode "text=⚠️ SSH MULTI LOGIN
Username: ${user}
Limit IP: ${limit}
Detected IP: ${count}
IPs: ${ips}
Action: ${action}" >/dev/null 2>&1 || true
}

# Port SSH/Dropbear yang benar-benar menerima koneksi client.
# Socket tunnel/forward (port lokal ephemeral) TIDAK boleh dihitung sebagai IP login.
listener_ports() {
    local ports
    ports=$(ss -tlnpH 2>/dev/null | awk '
      /sshd|dropbear/ {
        local=$4
        if (local ~ /^\[/) { sub(/^.*\]:/,"",local) } else { sub(/^.*:/,"",local) }
        gsub(/[^0-9].*/,"",local)
        if (local != "") print local
      }' | sort -u | tr '\n' ' ')
    printf '%s' "${ports:-22 2222 2223 109 143}"
}

# Print: pid<TAB>user<TAB>remote_ip for live SSH/Dropbear sockets.
live_sessions() {
    ss -tnpH 2>/dev/null | awk -v ports="${SSH_PORTS:-22 2222 2223 109 143}" '
      BEGIN { n=split(ports,a," "); for (i=1; i<=n; i++) ok[a[i]]=1 }
      /ESTAB|SYN-RECV/ {
        # Hanya socket yang local port-nya port listener SSH/Dropbear.
        # Ini mencegah koneksi keluar dari tunnel user (mis. bot/curl) ikut
        # dihitung sebagai IP login dan memicu suspend palsu.
        local=$4
        if (local ~ /^\[/) { sub(/^.*\]:/,"",local) } else { sub(/^.*:/,"",local) }
        gsub(/[^0-9].*/,"",local)
        if (!(local in ok)) next
        peer=$5
        # Extract source port safely for IPv4 and bracketed IPv6.
        if (peer ~ /^\[/) { port=peer; sub(/^.*\]:/,"",port); gsub(/[^0-9].*/,"",port); sub(/^\[[^]]+\].*/,"",peer); gsub(/^\[|\]$/,"",peer) }
        else { port=peer; sub(/^.*:/,"",port); sub(/:[0-9]+$/,"",peer) }
        if (match($0,/pid=[0-9]+/)) {
          pid=substr($0,RSTART+4,RLENGTH-4)
          print pid "\t" peer "\t" port
        }
      }' | while IFS=$'\t' read -r pid ip peerport; do
        args=$(ps -p "$pid" -o args= 2>/dev/null)
        [ -n "$args" ] || continue
        user=$(printf '%s\n' "$args" | sed -nE 's/.*sshd(-session)?:[[:space:]]*([^ @[]+).*/\2/p')
        [ -z "$user" ] && user=$(printf '%s\n' "$args" | sed -nE 's/.*dropbear[^:]*:[[:space:]]*([^ ]+).*/\1/p')
        [ -n "$user" ] || continue
        if [ "$ip" = "127.0.0.1" ] || [ "$ip" = "::1" ]; then
            _mapped=$(awk -v p="$peerport" '$2==p {print $3}' "${WS_SSH_MAP:-/run/ws-ssh.map}" 2>/dev/null | tail -1)
            [ -n "$_mapped" ] && ip="$_mapped"
        fi
        [[ "$ip" == "127.0.0.1" || "$ip" == "::1" || -z "$ip" ]] && continue
        printf '%s\t%s\t%s\n' "$pid" "$user" "$ip"
      done
}

# Fallback for systems where ss does not expose the child PID: use auth.log
# to map live sshd/sshd-session PIDs and preserve timestamp/IP compatibility.
log_sessions() {
    [ -r "$LOG" ] || return 0
    awk -v year="$(date +%Y)" '
      function validip(x) { return x ~ /^[0-9a-fA-F:.]+$/ }
      {
        pid=""; u=""; ip=""; port=""
        if (!match($0, /(sshd-session|sshd|dropbear)\[[0-9]+\]:/)) next
        p=substr($0,RSTART,RLENGTH); sub(/^.*\[/,"",p); sub(/\].*/,"",p); pid=p
        if ($0 ~ /Accepted (password|publickey|keyboard-interactive)/) {
          u=$0; sub(/.*Accepted [^ ]+ for /,"",u); sub(/ from .*/,"",u)
          ip=$0; sub(/.* from /,"",ip); sub(/ port .*/,"",ip)
          port=$0; sub(/.* port /,"",port); sub(/ .*/,"",port)
        } else if ($0 ~ /auth succeeded for/) {
          u=$0; sub(/.*auth succeeded for /,"",u); sub(/ from .*/,"",u); gsub(/\047/,"",u)
          ip=$0; sub(/.* from /,"",ip); sub(/ .*/,"",ip)
          port=ip; sub(/^.*:/,"",port); sub(/:[0-9]+$/, "", ip)
        }
        if (u!="" && validip(ip)) print pid "\t" u "\t" ip "\t" port
      }' "$LOG" | while IFS=$'\t' read -r pid user ip peerport; do
          kill -0 "$pid" 2>/dev/null || continue
        args=$(ps -p "$pid" -o args= 2>/dev/null)
        case "$args" in *sshd*|*dropbear*) ;; *) continue ;; esac
        case "$args" in *"$user"*) ;; *) continue ;; esac
        if [ "$ip" = "127.0.0.1" ] || [ "$ip" = "::1" ]; then
            _mapped=$(awk -v p="$peerport" '$2==p {print $3}' "${WS_SSH_MAP:-/run/ws-ssh.map}" 2>/dev/null | tail -1)
            [ -n "$_mapped" ] && ip="$_mapped"
        fi
        [[ "$ip" == "127.0.0.1" || "$ip" == "::1" || -z "$ip" ]] && continue
        printf '%s\t%s\t%s\n' "$pid" "$user" "$ip"
      done
}

check_once() {
    [ -d "$DIR" ] || return 0
    declare -A PIDS IPS
    SSH_PORTS=$(listener_ports)
    while IFS=$'\t' read -r pid user ip; do
        [ -n "$user" ] && [ -n "$ip" ] || continue
        PIDS["$user"]+=" $pid"
        IPS["$user"]+=" $ip"
    done < <(live_sessions)
    while IFS=$'\t' read -r pid user ip; do
        [ -n "$user" ] && [ -n "$ip" ] || continue
        PIDS["$user"]+=" $pid"
        IPS["$user"]+=" $ip"
    done < <(log_sessions)

    for file in "$DIR"/*; do
        [ -f "$file" ] || continue
        user=${file##*/}; limit=$(tr -d '[:space:]' < "$file" 2>/dev/null)
        [[ "$limit" =~ ^[0-9]+$ ]] || continue
        [ "$limit" -gt 0 ] || continue
        # Already frozen by jeda-mullog: do not reset the timer.
        if [ -x /usr/local/sbin/jeda-mullog ] && /usr/local/sbin/jeda-mullog is-suspended ssh "$user" >/dev/null 2>&1; then
            continue
        fi
        uniq=$(printf '%s\n' "${IPS[$user]:-}" | tr ' ' '\n' | sed '/^$/d' | sort -u)
        count=$(printf '%s\n' "$uniq" | sed '/^$/d' | wc -l)
        [ "$count" -gt "$limit" ] || continue
        exec 9>"$LOCK"; flock -x 9
        _jeda_ok=0
        if [ -x /usr/local/sbin/jeda-mullog ]; then
            /usr/local/sbin/jeda-mullog suspend ssh "$user" "$limit" "$count" >/dev/null 2>&1
            [ "$?" -eq 0 ] && _jeda_ok=1
        fi
        if [ "$_jeda_ok" -eq 0 ]; then
            for pid in ${PIDS[$user]:-}; do kill -TERM "$pid" 2>/dev/null || true; done
            sleep 1
            for pid in ${PIDS[$user]:-}; do kill -KILL "$pid" 2>/dev/null || true; done
        fi
        # Kill only the user's sessions; never userdel and never remove the account.
        flock -u 9
        if [ "$_jeda_ok" -eq 0 ]; then
            # Engine disabled/missing: fallback to the old kill-only behaviour.
            send_log "$user" "$limit" "$count" "$(printf '%s' "$uniq" | tr '\n' ',')" "sessions killed"
        fi
        # When the engine suspends the account, it sends the Telegram notification.
    done
}

while true; do
    sleep 60
    check_once
done
