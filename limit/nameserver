#!/usr/bin/env bash
# ============================================================
#  nameserver - Installer SlowDNS Server (DNSTT) untuk premi.sh
# ============================================================
set -euo pipefail

REPO="${KYT_REPO:-https://raw.githubusercontent.com/victor3232/xhttp/main}"
[[ "$REPO" != */ ]] && REPO="${REPO}/"

MYIP=$(curl -sS ipv4.icanhazip.com || wget -qO- ipv4.icanhazip.com || curl -sS ifconfig.me)
# EC2/Lightsail memakai public IP sebagai NAT, bukan IP interface.
# SlowDNS harus bind ke IP yang benar-benar ada di interface.
BIND_IP="$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]\+\).*/\1/p' | head -n1 || true)"
if [ -z "$BIND_IP" ]; then
  BIND_IP="$(ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}' || true)"
fi
if [ -z "$BIND_IP" ]; then
  BIND_IP="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
fi
if [ -z "$BIND_IP" ]; then
  BIND_IP="$MYIP"
fi

xray_domain=$(cat /etc/xray/domain 2>/dev/null || cat /root/domain 2>/dev/null || echo "$MYIP")
# Pisahkan domain SlowDNS dari domain Xray supaya delegasi NS tidak
# menimpa resolusi domain Xray.
# Kalau domain SlowDNS sudah pernah dipilih (menu GANTI NS), pertahankan.
existing_dns=$(cat /etc/xray/dns 2>/dev/null || cat /root/slowdns/dns_domain 2>/dev/null || true)
domain="${existing_dns:-dns.${xray_domain}}"
ns_domain="ns.${domain}"

echo "Memasang SlowDNS Server untuk domain: $domain ($ns_domain)..."
echo "Menggunakan listener IP interface: $BIND_IP (public: $MYIP)"

# 1. Hapus redirect lawas UDP 53 -> 5300 jika ada
while iptables -t nat -C PREROUTING -i eth0 -p udp --dport 53 -j REDIRECT --to-ports 5300 2>/dev/null; do
  iptables -t nat -D PREROUTING -i eth0 -p udp --dport 53 -j REDIRECT --to-ports 5300
done
sed -i '\|iptables -t nat -I PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 5300|d' /etc/rc.local 2>/dev/null || true
sed -i '\|-A PREROUTING -i eth0 -p udp -m udp --dport 53 -j REDIRECT --to-ports 5300|d' /etc/iptables/rules.v4 /etc/iptables.up.rules 2>/dev/null || true

# 2. Unduh bundle slowdns jika belum ada
ARCHIVE="/root/slowdns-linux-amd64.tar.gz"
if [ ! -s "$ARCHIVE" ]; then
    wget -4 -q --timeout=30 -O "$ARCHIVE" "${REPO}limit/slowdns-linux-amd64.tar.gz" || \
    curl -4 -fsSL --max-time 30 -o "$ARCHIVE" "${REPO}limit/slowdns-linux-amd64.tar.gz" || true
fi

if [ ! -s "$ARCHIVE" ]; then
    echo "Peringatan: Gagal mengunduh bundle slowdns dari repo. Mengabaikan pemasangan."
    exit 0
fi

# 3. Ekstrak ke /root/slowdns
WORK="/root/slowdns"
# Simpan key lama supaya pubkey tidak berubah saat reinstall.
KEY_BAK=""
if [ -s "$WORK/server.key" ] && [ -s "$WORK/server.pub" ]; then
    KEY_BAK="$(mktemp -d /tmp/slowdns-key.XXXXXX)"
    cp -a "$WORK/server.key" "$WORK/server.pub" "$KEY_BAK/"
fi
rm -rf "$WORK"
install -d -m 0700 "$WORK"
tar -xzf "$ARCHIVE" -C "$WORK"
chown -R root:root "$WORK"
chmod 0700 "$WORK"
chmod 0755 "$WORK/slowdns" "$WORK/install.sh"
chmod 0644 "$WORK/README.md"

# 4. Simpan domain SlowDNS (bukan host NS) untuk semua output akun
mkdir -p /etc/xray /etc/slowdns /root/slowdns
echo "$domain" > /etc/xray/dns
echo "$domain" > /root/slowdns/dns_domain
echo "$domain" > /etc/xray/dns_domain 2>/dev/null || true

# 5. Pasang service otomatis
# Unit lama harus dibuang: WORK sudah dihapus di atas, sedangkan install.sh
# menolak reinstall kalau unit ada tapi slowdns.env tidak ada.
systemctl stop slowdns >/dev/null 2>&1 || true
systemctl disable slowdns >/dev/null 2>&1 || true
rm -f /etc/systemd/system/slowdns.service
systemctl daemon-reload >/dev/null 2>&1 || true
printf '%s\n53\n%s\n127.0.0.1:22\n' "$BIND_IP" "$domain" | bash "$WORK/install.sh" install

# 5b. Kembalikan key lama (kalau ada) agar Public Key pelanggan tidak berubah.
if [ -n "$KEY_BAK" ]; then
    install -m 0600 "$KEY_BAK/server.key" "$WORK/server.key"
    install -m 0644 "$KEY_BAK/server.pub" "$WORK/server.pub"
    systemctl restart slowdns >/dev/null 2>&1 || true
    sleep 1
    if ! systemctl is-active --quiet slowdns; then
        echo "Peringatan: key lama tidak bisa dipakai, membuat key baru..."
        rm -f "$WORK/server.key" "$WORK/server.pub" "$WORK/slowdns.env" /etc/systemd/system/slowdns.service
        systemctl daemon-reload >/dev/null 2>&1 || true
        printf '%s\n53\n%s\n127.0.0.1:22\n' "$BIND_IP" "$domain" | bash "$WORK/install.sh" install || true
    fi
    rm -rf "$KEY_BAK"
fi

# 6. Kompatibilitas symlink
ln -sfn /root/slowdns/server.pub /etc/slowdns/server.pub

if systemctl is-active --quiet slowdns; then
    echo "SlowDNS Server berhasil aktif pada UDP 53 -> SSH 22!"
    if [ -s /root/slowdns/server.pub ]; then
        echo "Public Key Server: $(cat /root/slowdns/server.pub)"
    else
        echo "Peringatan: server.pub tidak ditemukan."
    fi
else
    echo "Peringatan: slowdns.service belum berjalan aktif."
    echo "Cek: journalctl -u slowdns -n 20"
fi
