#!/bin/bash
# Guard against non-interactive terminal loop (cron/pipe/closed SSH)
if [ ! -t 0 ] && [ -z "${SSH_TTY:-}" ]; then
    exit 0
fi
clear
ISP=$(cat /etc/xray/isp 2>/dev/null)
CITY=$(cat /etc/xray/city 2>/dev/null)
domain=$(cat /etc/xray/domain 2>/dev/null)
IPVPS=$(curl -s --max-time 3 ipv4.icanhazip.com)
MODEL=$(grep -w PRETTY_NAME /etc/os-release 2>/dev/null | cut -d'"' -f2)
CPU_MODEL=$(awk -F: '/model name/ {gsub(/^[ \t]+/,"",$2); print $2; exit}' /proc/cpuinfo)
CPU_CORES=$(nproc 2>/dev/null || echo 1)
RAM_TOTAL=$(free -m | awk 'NR==2 {print $2}')
RAM_USED=$(free -m | awk 'NR==2 {print $3}')
RAM_GB=$(awk "BEGIN { printf \"%.0f\", $RAM_TOTAL / 1024 }")
[[ "$RAM_GB" -lt 1 ]] && RAM_GB=1
uptime_info=$(uptime -p 2>/dev/null | sed 's/^up //')
SWAP_TOTAL=$(free -m | awk 'NR==3 {print $2}')
SWAP_USED=$(free -m | awk 'NR==3 {print $3}')

_xray=$(systemctl is-active xray 2>/dev/null)
_ws=$(systemctl is-active ws 2>/dev/null)
[[ "$_ws" != "active" ]] && _ws=$(systemctl is-active ws-ssh 2>/dev/null)
_ovpn=$(systemctl is-active openvpn 2>/dev/null)
[[ "$_ovpn" != "active" ]] && _ovpn=$(systemctl is-active openvpn-server@server-tcp 2>/dev/null)

ssh1=0
while read -r _u; do
    [ -n "$_u" ] || continue
    _uid="$(id -u "$_u" 2>/dev/null)" || continue
    [ "${_uid:-0}" -ge 1000 ] && ssh1=$((ssh1+1))
done < <(awk '/^#ssh# /{print $2}' /etc/ssh/.ssh.db 2>/dev/null | sort -u)
vmc=$(grep -c -E '^### ' /etc/xray/config.json 2>/dev/null); vma=$((vmc/5))
vlx=$(grep -c -E '^#& ' /etc/xray/config.json 2>/dev/null); vla=$((vlx/5))
trx=$(grep -c -E '^#! ' /etc/xray/config.json 2>/dev/null); trb=$((trx/5))
ssx=$(grep -oE '^#!# [^ ]+' /etc/xray/config.json 2>/dev/null | awk '{print $2}' | sort -u | wc -l); ssa=$ssx
l2tx=$(grep -oE '^### [^ ]+' /etc/l2tp/.l2tp.db 2>/dev/null | awk '{print $2}' | sort -u | wc -l); l2ta=${l2tx:-0}
total=$(( ssh1 + vma + vla + trb + ssa + l2ta ))

LICENSE_CONF="/etc/kyt-license.conf"
LICENSE_URL=""
[ -s "$LICENSE_CONF" ] && LICENSE_URL=$(tr -d '\r\n' < "$LICENSE_CONF" 2>/dev/null)
LICENSE_URL="${KYT_LICENSE_URL:-${LICENSE_URL:-https://raw.githubusercontent.com/victor3232/xhttp/main}}"
data_ip="${LICENSE_URL%/}/izin"
MYIP="$IPVPS"
username=$(curl -4 -sS --max-time 5 "$data_ip" 2>/dev/null | grep "$MYIP" | awk '{print $2}')
exp=$(curl -4 -sS --max-time 5 "$data_ip" 2>/dev/null | grep "$MYIP" | awk '{print $3}')
today=$(date +%Y-%m-%d)
if [[ -n "$exp" && "$today" < "$exp" ]]; then _sts="Active"; _sc=$'\033[92m'; else _sts="Expired"; _sc=$'\033[91m'; fi

stxt() { [[ "$1" == "active" ]] && printf 'ON' || printf 'OFF'; }
scol() { [[ "$1" == "active" ]] && printf '\033[93m' || printf '\033[91m'; }
sdot() { [[ "$1" == "active" ]] && printf '\033[92m●' || printf '\033[91m●'; }
_up=0; for _s in "$_xray" "$_ws" "$_ovpn"; do [[ "$_s" == "active" ]] && _up=$((_up+1)); done
if (( _up == 3 )); then _ov="GOOD"; _oc=$'\033[92m'; elif (( _up > 0 )); then _ov="WARN"; _oc=$'\033[93m'; else _ov="FAIL"; _oc=$'\033[91m'; fi

# ---------- DASHBOARD UI (theme-aware) ----------
THEME=$(grep -E '^THEME=' /etc/kyt-theme.conf 2>/dev/null | cut -d= -f2 | tr -d ' ' | tr 'a-z' 'A-Z')
case "$THEME" in
  RED)    A=$'\033[38;2;248;113;113m'; AB=$'\033[38;2;185;28;28m';  AD=$'\033[38;2;127;29;29m';;
  BLUE)   A=$'\033[38;2;96;165;250m';  AB=$'\033[38;2;29;78;216m';  AD=$'\033[38;2;30;64;175m';;
  CYAN)   A=$'\033[38;2;34;211;238m';  AB=$'\033[38;2;8;145;178m';   AD=$'\033[38;2;22;101;120m';;
  GREEN)  A=$'\033[38;2;74;222;128m';  AB=$'\033[38;2;21;128;61m';   AD=$'\033[38;2;22;101;52m';;
  PURPLE) A=$'\033[38;2;192;132;252m'; AB=$'\033[38;2;126;34;206m';  AD=$'\033[38;2;88;28;135m';;
  PINK)   A=$'\033[38;2;244;114;182m'; AB=$'\033[38;2;190;24;93m';   AD=$'\033[38;2;131;24;67m';;
  WHITE)  A=$'\033[97m';              AB=$'\033[37m';              AD=$'\033[90m';;
  *)      THEME=GOLD; A=$'\033[38;2;255;191;36m'; AB=$'\033[38;2;204;153;0m'; AD=$'\033[38;2;153;115;0m';;
esac
W=$'\033[38;2;255;255;255m'
G=$'\033[92m'
Y=$'\033[93m'
R=$'\033[91m'
N=$'\033[0m'
B=$'\033[1m'
MAG=$AB
O=$A
CYAN=$A

# Lebar dashboard mengikuti referensi; kotak akun lebih kecil dan benar-benar di tengah.
INNER=52
SINNER=48
LEFT_PAD=2

_repeat_char() { local ch="$1" count="$2" out='' i; for ((i=0; i<count; i++)); do out+="$ch"; done; printf '%s' "$out"; }
_indent() { printf '%*s' "$1" ''; }
top_box()    { printf '%s%s┌%s┐%s\n' "$(_indent "$LEFT_PAD")" "$A" "$(_repeat_char '─' "$1")" "$N"; }
mid_box()    { printf '%s%s├%s┤%s\n' "$(_indent "$LEFT_PAD")" "$A" "$(_repeat_char '─' "$1")" "$N"; }
bottom_box() { printf '%s%s└%s┘%s\n' "$(_indent "$LEFT_PAD")" "$A" "$(_repeat_char '─' "$1")" "$N"; }
top_box_at()    { printf '%s%s┌%s┐%s\n' "$(_indent "$1")" "$A" "$(_repeat_char '─' "$2")" "$N"; }
mid_box_at()    { printf '%s%s├%s┤%s\n' "$(_indent "$1")" "$A" "$(_repeat_char '─' "$2")" "$N"; }
bottom_box_at() { printf '%s%s└%s┘%s\n' "$(_indent "$1")" "$A" "$(_repeat_char '─' "$2")" "$N"; }
center_title_at() {
    local ind="$1" width="$2" title="$3" pad right
    pad=$(( (width - ${#title}) / 2 ))
    right=$(( width - ${#title} - pad ))
    (( pad < 0 )) && pad=0
    (( right < 0 )) && right=0
    printf '%s%s│%s%*s%s%s%*s%s│%s\n' "$(_indent "$ind")" "$A" "$N" "$pad" '' "$A$B" "$title" "$right" '' "$A" "$N"
}
box_row()    { printf '%s%s│%s %-*.*s %s│%s\n' "$(_indent "$LEFT_PAD")" "$A" "$N" "$INNER" "$INNER" "$1" "$A" "$N"; }
center_row() {
    local width="$1" text="$2" color="${3:-$W}"
    local pad=$(( (width - ${#text}) / 2 ))
    local right=$(( width - ${#text} - pad ))
    (( pad < 0 )) && pad=0
    (( right < 0 )) && right=0
    printf '%s%s│%s %*s%s%s%*s %s│%s\n' \
        "$(_indent "$LEFT_PAD")" "$A" "$N" "$pad" '' "$color" "$text" "$right" '' "$A" "$N"
}
info_line() {
    local label="$1" value="$2" color="${3:-$W}" row
    printf -v row '%-8s : %s' "$label" "$value"
    printf '%s%s│%s %-8s : %s%-*s%s %s│%s\n' \
        "$(_indent "$LEFT_PAD")" "$A" "$N" "$label" "$color" "$((INNER-13))" "$value" "$N" "$A" "$N"
}
account_line() {
    local label="$1" value="$2" plain pad right
    printf -v plain '%-12s : %3s  ACCOUNT' "$label" "$value"
    pad=$(( (SINNER - ${#plain}) / 2 ))
    right=$(( SINNER - ${#plain} - pad ))
    (( pad < 0 )) && pad=0
    (( right < 0 )) && right=0
    printf '%s%s│%s%*s%-12s : %s%3s%s  ACCOUNT%*s%s│%s\n' \
        "$(_indent "$((LEFT_PAD + (INNER-SINNER)/2))")" "$A" "$N" \
        "$pad" '' "$label" "$Y" "$value" "$N" "$right" '' "$A" "$N"
}
center_title() {
    local title="$1" pad=$(( (INNER - ${#1}) / 2 )) right
    right=$(( INNER - ${#title} - pad ))
    printf '%s%s│%s%*s%s%s%*s%s│%s\n' \
        "$(_indent "$LEFT_PAD")" "$A" "$N" "$pad" '' "$A$B" "$title" "$right" '' "$A" "$N"
}

colored_line() {
    local raw="$1" width="${2:-$INNER}" vis
    vis=$(printf '%s' "$raw" | sed 's/\x1b\[[0-9;]*m//g')
    printf '%s%s│%s %s%*s %s│%s\n' "$(_indent "$LEFT_PAD")" "$A" "$N" "$raw" "$((width - 2 - ${#vis}))" "" "$A" "$N"
}
menu_row() {
    local left="$1" right="$2" raw
    printf -v raw '  %-22s %-22s' "$left" "$right"
    colored_line "$raw"
}

if [[ -n "$exp" ]]; then
    _exp_epoch=$(date -d "$exp" +%s 2>/dev/null)
    if [[ -n "$_exp_epoch" ]]; then
        _days=$(( (_exp_epoch - $(date +%s) + 86399) / 86400 ))
        (( _days < 0 )) && _days=0
        _exp_label="${_days} Days"
    else
        _exp_label="$exp"
    fi
else
    _exp_label="N/A"
fi

echo ""
top_box "$INNER"
center_title "VPS SERVER INFORMATION"
bottom_box "$INNER"
echo ""
top_box "$INNER"
info_line "OS"     "$MODEL"
info_line "RAM"    "${RAM_USED}M / ${RAM_TOTAL}M"
info_line "SWAP"   "${SWAP_USED}M / ${SWAP_TOTAL}M"
info_line "CITY"   "$CITY"
info_line "ISP"    "$ISP"
info_line "IP"     "$IPVPS" "$CYAN"
info_line "DOMAIN" "$domain" "$CYAN"
info_line "UPTIME" "$uptime_info"
bottom_box "$INNER"

echo ""
# Teks status dipusatkan dan memenuhi lebar kotak tanpa sisa spasi di kanan.
_status_plain="XRAY : $(stxt "$_xray") | SSH-WS : $(stxt "$_ws") | OPENVPN : $(stxt "$_ovpn") | $_ov"
top_box "$INNER"
_status_pad=$(( (INNER - ${#_status_plain}) / 2 ))
_status_right=$(( INNER - ${#_status_plain} - _status_pad ))
printf '%s%s│%s%*sXRAY : %s%s%s | SSH-WS : %s%s%s | OPENVPN : %s%s%s | %s%s%s%*s%s│%s\n' \
    "$(_indent "$LEFT_PAD")" "$A" "$N" "$(( _status_pad > 0 ? _status_pad : 0 ))" '' \
    "$(scol "$_xray")" "$(stxt "$_xray")" "$N" \
    "$(scol "$_ws")" "$(stxt "$_ws")" "$N" \
    "$(scol "$_ovpn")" "$(stxt "$_ovpn")" "$N" \
    "$_oc" "$_ov" "$N" "$(( _status_right > 0 ? _status_right : 0 ))" '' "$A" "$N"
bottom_box "$INNER"

echo ""
# LIST ACCOUNTS: kotak persegi penuh, garis nyambung, dipusatkan.
_ACCOUNT_LEFT=$((LEFT_PAD + (INNER-SINNER)/2))
_ACCOUNT_INNER=$SINNER

top_box_at "$_ACCOUNT_LEFT" "$_ACCOUNT_INNER"
center_title_at "$_ACCOUNT_LEFT" "$_ACCOUNT_INNER" "LIST ACCOUNTS"
mid_box_at "$_ACCOUNT_LEFT" "$_ACCOUNT_INNER"
account_line "SSH/OPENVPN" "$ssh1"
account_line "VMESS"       "$vma"
account_line "VLESS"       "$vla"
account_line "TROJAN"      "$trb"
account_line "SS-R"        "$ssa"
account_line "SS-Libev"    "0"
account_line "L2TP"        "$l2ta"
bottom_box_at "$_ACCOUNT_LEFT" "$_ACCOUNT_INNER"

echo ""
top_box "$INNER"
# Warna nilai: versi hijau, data pelanggan oranye.
printf '%s%s│%s %-12s : %s%-*.*s%s%s│%s\n' "$(_indent "$LEFT_PAD")" "$A" "$N" "Version" "$O" "$((INNER-16))" "$((INNER-16))" "3.0 ULTIMATE" "$N" "$A" "$N"
printf '%s%s│%s %-12s : %s%-*.*s%s%s│%s\n' "$(_indent "$LEFT_PAD")" "$A" "$N" "Client Name" "$O" "$((INNER-16))" "$((INNER-16))" "${username:-N/A}" "$N" "$A" "$N"
printf '%s%s│%s %-12s : %s%-*.*s%s%s│%s\n' "$(_indent "$LEFT_PAD")" "$A" "$N" "Expiry In" "$O" "$((INNER-16))" "$((INNER-16))" "$_exp_label" "$N" "$A" "$N"
bottom_box "$INNER"

echo ""
top_box "$INNER"
center_title "MAIN MENU"
mid_box "$INNER"
menu_row " [1] SSH / OpenVPN" " [6] L2TP / IKEv2"
menu_row " [2] VMess"         " [7] All Xray"
menu_row " [3] VLESS"         " [8] Backup & Restore"
menu_row " [4] Trojan"        " [9] Utility"
menu_row " [5] Shadowsocks"   " [0] Exit"
bottom_box "$INNER"
echo ""
printf '  %sSelect [1-9, 0]%s : ' "$Y" "$N"
if ! read -r opt; then
    exit 0
fi
echo ""
case $opt in
1) clear; m-sshws ;;
2) clear; m-vmess ;;
3) clear; m-vless ;;
4) clear; m-trojan ;;
5) clear; m-ssws ;;
6) clear; m-l2tp ;;
7) clear; add-allxray ;;
8) clear; menu-backup ;;
9) clear; utility ;;
0|x|q) clear; exit 0 ;;
*) clear; exec menu ;;
esac
