"

echo -e " ${CYAN}[1/4]${NC} Mengumpulkan data akun..."
JUMLAH=0
SEMENTARA=$(mktemp -d /tmp/kytbackup.XXXXXX)
LEWAT=""

siapkan() {
    # $1 = path asli
    local p="$1"
    [ -e "$p" ] || return 0
    if [ -f "$p" ]; then
        local sz
        sz=$(stat -c%s "$p" 2>/dev/null || echo 0)
        if [ "$sz" -gt "$BATAS_FILE" ]; then
            # database web/bot tetap ikut lewat snapshot SQLite di bawah
            case "$p" in
                /opt/kyt-web/data/web.db|/usr/bin/kyt/database.db|/usr/bin/database.db|/usr/local/kyt/database.db|/root/kyt/database.db) ;;
                *) LEWAT="$LEWAT $p" ;;
            esac
            return 0
        fi
    fi
    local tujuan="$SEMENTARA/${p#/}"
    mkdir -p "$(dirname "$tujuan")" 2>/dev/null
    cp -a "$p" "$tujuan" 2>/dev/null && JUMLAH=$((JUMLAH + 1))
}

for f in $BERKAS; do
    siapkan "$f"
done

for d in $FOLDER; do
    if [ -d "$d" ]; then
        # telusuri isi folder, lewati file besar
        while IFS= read -r f; do
            siapkan "$f"
        done < <(find "$d" -type f 2>/dev/null)
    else
        siapkan "$d"
    fi
done

# Sertifikat Let's Encrypt memakai symlink; ikutkan isinya ke zip.
while IFS= read -r f; do
    siapkan "$f"
done < <(find /etc/letsencrypt/live -type l 2>/dev/null)

# Snapshot konsisten database (SQLite backup API).
# Database TIDAK pernah disalin mentah: kalau ada user/pesanan baru saat
# backup berjalan, data tetap utuh dan file tidak korup.
snapshot_db() {
    # $1 = database asli, $2 = tujuan di dalam SEMENTARA, $3 = label
    local asal="$1" tuj="$2" label="$3"
    [ -f "$asal" ] || return 0
    command -v python3 >/dev/null 2>&1 || {
        echo -e " ${RED}python3 tidak ditemukan: database $label tidak bisa dibackup aman.${NC}"
        return 1
    }
    mkdir -p "$(dirname "$tuj")" 2>/dev/null
    rm -f "$tuj" "$tuj-wal" "$tuj-shm"
    if python3 - "$asal" "$tuj" "$label" <<'PY'
import sqlite3
import sys

src_path, dst_path, label = sys.argv[1], sys.argv[2], sys.argv[3]
src = sqlite3.connect("file:%s?mode=ro" % src_path, uri=True, timeout=30)
dst = sqlite3.connect(dst_path, timeout=30)
try:
    with dst:
        src.backup(dst)
    dst.execute("PRAGMA journal_mode=DELETE")
    hasil = dst.execute("PRAGMA integrity_check").fetchone()
    if not hasil or str(hasil[0]).lower() != "ok":
        raise RuntimeError("integrity_check: %s" % (hasil,))
finally:
    dst.close()
    src.close()
print("snapshot %s: ok" % label)
PY
    then
        rm -f "$tuj-wal" "$tuj-shm"
        chmod 600 "$tuj" 2>/dev/null || true
        JUMLAH=$((JUMLAH + 1))
        return 0
    fi
    rm -f "$tuj" "$tuj-wal" "$tuj-shm"
    echo -e " ${RED}Gagal membuat snapshot database $label. Backup dibatalkan.${NC}"
    return 1
}

WEB_DB_ASAL="/opt/kyt-web/data/web.db"
BOT_DB_ASAL=""
for _p in /usr/bin/kyt/database.db /usr/bin/database.db /usr/local/kyt/database.db /root/kyt/database.db; do
    [ -f "$_p" ] && { BOT_DB_ASAL="$_p"; break; }
done

if ! snapshot_db "$WEB_DB_ASAL" "$SEMENTARA/opt/kyt-web/data/web.db" "website"; then
    rm -rf "$SEMENTARA"
    read -n 1 -s -r -p " Tekan apa saja untuk kembali"
    menu-backup
    exit 1
fi
if ! snapshot_db "$BOT_DB_ASAL" "$SEMENTARA/usr/bin/kyt/database.db" "bot"; then
    rm -rf "$SEMENTARA"
    read -n 1 -s -r -p " Tekan apa saja untuk kembali"
    menu-backup
    exit 1
fi

if [ "$JUMLAH" = "0" ]; then
    echo -e " ${RED}Tidak ada data yang bisa dibackup.${NC}"
    rm -rf "$SEMENTARA"
    read -n 1 -s -r -p " Tekan apa saja untuk kembali"
    menu-backup
    exit 1
fi

echo -e "       -> ${GREEN}${JUMLAH} berkas${NC} terkumpul"
[ -n "$LEWAT" ] && echo -e "       -> dilewati (terlalu besar):${YELLOW}${LEWAT}${NC}"

# ---------- manifest: checksum + jumlah data (anti file korup/hilang) ----------
MANIFEST="$SEMENTARA/kyt-backup-manifest.json"
echo -e " ${CYAN}[2/4]${NC} Membuat manifest & memeriksa database ..."
if ! python3 - "$SEMENTARA" "$MANIFEST" "$(hostname 2>/dev/null || echo vps)" "$JUMLAH" <<'PY'
import datetime as DT
import hashlib
import json
import os
import sqlite3
import sys

root, manifest_path, host, jumlah = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])

def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for blok in iter(lambda: f.read(1024 * 1024), b""):
            h.update(blok)
    return h.hexdigest()

def db_info(rel):
    path = os.path.join(root, rel)
    if not os.path.isfile(path):
        return None
    info = {"path": rel, "size": os.path.getsize(path), "sha256": sha256(path)}
    try:
        con = sqlite3.connect("file:%s?mode=ro" % path, uri=True, timeout=30)
        integ = con.execute("PRAGMA integrity_check").fetchone()
        info["integrity"] = str(integ[0]) if integ else "unknown"
        tabel = [r[0] for r in con.execute(
            "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")]
        counts = {}
        for t in tabel:
            try:
                counts[t] = con.execute('SELECT COUNT(*) FROM "%s"' % t.replace('"', '""')).fetchone()[0]
            except Exception:
                pass
        info["counts"] = counts
        if "store_user" in counts:
            try:
                info["saldo"] = con.execute(
                    "SELECT COALESCE(SUM(saldo),0) FROM store_user").fetchone()[0]
            except Exception:
                pass
        if "users" in counts:
            try:
                info["saldo_milli"] = con.execute(
                    "SELECT COALESCE(SUM(balance_milli),0) FROM users").fetchone()[0]
            except Exception:
                pass
        con.close()
    except Exception as e:
        info["integrity"] = "ERROR: %s" % e
    return info

hashes = {}
for walk_root, _dirs, files in os.walk(root):
    for fn in files:
        p = os.path.join(walk_root, fn)
        rel = os.path.relpath(p, root).replace(os.sep, "/")
        if rel == "kyt-backup-manifest.json":
            continue
        try:
            if os.path.islink(p):
                hashes[rel] = {"type": "symlink", "target": os.readlink(p)}
            elif os.path.isfile(p):
                hashes[rel] = {"type": "file", "size": os.path.getsize(p),
                               "sha256": sha256(p)}
        except Exception as e:
            hashes[rel] = {"type": "error", "error": str(e)}

data = {
    "format": "kyt-backup-v2",
    "created": DT.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
    "host": host,
    "files": len(hashes),
    "web_db": db_info("opt/kyt-web/data/web.db"),
    "bot_db": db_info("usr/bin/kyt/database.db"),
    "hashes": hashes,
}
with open(manifest_path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=1, sort_keys=True)
print("manifest: %d file, web_db=%s, bot_db=%s" % (
    len(hashes),
    "ya" if data["web_db"] else "tidak ada",
    "ya" if data["bot_db"] else "tidak ada"))
PY
then
    echo -e " ${RED}Gagal membuat manifest. Backup dibatalkan.${NC}"
    rm -rf "$SEMENTARA"
    read -n 1 -s -r -p " Tekan apa saja untuk kembali"
    menu-backup
    exit 1
fi
# jumlah berkas unik (bukan hitungan ganda dari file+folder)
JUMLAH=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("files", 0))' "$MANIFEST" 2>/dev/null || echo "$JUMLAH")

# ---------- buat zip ----------
echo -e " ${CYAN}[3/4]${NC} Membuat file .zip ..."
cd "$SEMENTARA" || exit 1
if ! zip -rqy "$ZIP" . -x "*.pyc" >/dev/null 2>&1; then
    echo -e " ${RED}Gagal membuat zip.${NC}"
    cd /; rm -rf "$SEMENTARA"
    read -n 1 -s -r -p " Tekan apa saja untuk kembali"
    menu-backup
    exit 1
fi
cd /; rm -rf "$SEMENTARA"

# ---------- verifikasi file zip setelah dibuat ----------
if ! unzip -t "$ZIP" >/dev/null 2>&1; then
    echo -e " ${RED}File zip hasil backup RUSAK. Backup dibatalkan.${NC}"
    rm -f "$ZIP"
    read -n 1 -s -r -p " Tekan apa saja untuk kembali"
    menu-backup
    exit 1
fi
echo -e "       -> ${GREEN}zip terverifikasi utuh${NC}"

UKURAN=$(stat -c%s "$ZIP" 2>/dev/null || echo 0)
if [ "$UKURAN" -lt 1024 ]; then
    TAMPIL="$UKURAN byte"
elif [ "$UKURAN" -lt 1048576 ]; then
    TAMPIL="$((UKURAN / 1024)) KB"
else
    TAMPIL=$(awk "BEGIN{printf \"%.2f MB\", $UKURAN/1048576}")
fi

# ---------- ringkasan isi ----------
echo -e " ${CYAN}[4/4]${NC} Memeriksa isi zip ..."
ISI=$(unzip -l "$ZIP" 2>/dev/null)
cek_isi() {
    if echo "$ISI" | grep -q "$1"; then
        echo -e "    ${GREEN}[ok]${NC} $2"
    else
        echo -e "    ${YELLOW}[ - ]${NC} $2 (belum ada / belum dipakai)"
    fi
}
cek_isi "etc/passwd"                 "akun SSH & akun sistem"
cek_isi "etc/vmess/.vmess.db"        "akun VMess"
cek_isi "etc/vless/.vless.db"        "akun VLESS"
cek_isi "etc/trojan/.trojan.db"      "akun Trojan"
cek_isi "etc/shadowsocks/.shadowsocks.db" "akun Shadowsocks"
cek_isi "etc/l2tp/.l2tp.db"          "akun L2TP"
cek_isi "etc/ppp/chap-secrets"       "akun L2TP (CHAP)"
cek_isi "etc/ipsec.secrets"          "akun IKEv2"
cek_isi "etc/xray/config.json"       "konfigurasi Xray"
cek_isi "etc/xray/xray.key"          "sertifikat TLS Xray"
cek_isi "etc/haproxy/hap.pem"        "sertifikat haproxy"
cek_isi "usr/bin/kyt/database.db"    "database bot (saldo/pesanan)"
cek_isi "etc/kyt-theme.conf"         "tema warna menu/UI"
cek_isi "etc/kyt/limit"               "pemakaian kuota & IP akun"
cek_isi "etc/limit"                   "pemakaian kuota akun"
cek_isi "root/slowdns"                "konfigurasi SlowDNS (domain/key)"
cek_isi "etc/bot/.bot.db"             "token & admin bot Telegram"
cek_isi "kyt-backup-manifest.json"    "manifest checksum + jumlah data"
cek_isi "etc/kyt-web.conf"           "konfigurasi website + Turnstile"
cek_isi "etc/kyt-web-mail.key"       "API key email verifikasi (Brevo)"
cek_isi "opt/kyt-web/app.py"         "aplikasi website"
cek_isi "usr/local/sbin/kyt-web-configure-edge" "pengatur domain website"
cek_isi "opt/kyt-web/data/web.db"     "database website (branding, tema, server)"
cek_isi "opt/kyt-web/data/branding/"  "logo branding kustom"
cek_isi "usr/local/sbin/setting-web"  "setting website (domain, Turnstile, server)"
cek_isi "usr/local/sbin/slowdns-rcvbuf" "optimasi buffer SlowDNS"
cek_isi "usr/bin/kyt/modules/conn_notif.py" "monitor koneksi bot"
cek_isi "etc/logrotate.d/auth-log" "rotasi log auth"

# ---------- kirim ke Telegram ----------
KEY=""
CHATID=""
if [ -f /etc/bot/.bot.db ]; then
    KEY=$(grep -E "^#bot# " /etc/bot/.bot.db 2>/dev/null | tail -1 | awk '{print $2}')
    CHATID=$(grep -E "^#bot# " /etc/bot/.bot.db 2>/dev/null | tail -1 | awk '{print $3}')
fi
# cadangan: ambil dari var.txt bot
if { [ -z "$KEY" ] || [ -z "$CHATID" ]; } && [ -f /usr/bin/kyt/var.txt ]; then
    [ -z "$KEY" ] && KEY=$(sed -n "s/^BOT_TOKEN=//p" /usr/bin/kyt/var.txt 2>/dev/null | tr -d "'\"\r\n ")
    [ -z "$CHATID" ] && CHATID=$(sed -n "s/^ADMIN=//p" /usr/bin/kyt/var.txt 2>/dev/null | tr -d "'\"\r\n ")
fi

echo -e " ${CYAN}[4/4]${NC} Mengirim ke Telegram..."
KIRIM=""
if [ -n "$KEY" ] && [ -n "$CHATID" ]; then
    HOSTN=$(hostname 2>/dev/null)
    CAPTION="BACKUP VPS
Host : ${HOSTN}
Tanggal : $(date '+%d-%m-%Y %H:%M')
Isi : ${JUMLAH} berkas (${TAMPIL})
Simpan file ini. Untuk restore: menu 10 -> 02, upload zip ke /root lalu pilih."
    RESP=$(curl -s --max-time 120 \
        -F "chat_id=${CHATID}" \
        -F "document=@${ZIP}" \
        -F "caption=${CAPTION}" \
        "https://api.telegram.org/bot${KEY}/sendDocument" 2>/dev/null)
    if echo "$RESP" | grep -q '"ok":true'; then
        KIRIM="ya"
        FILE_ID=$(echo "$RESP" | python3 -c "import sys,json;d=json.load(sys.stdin);print(d.get('result',{}).get('document',{}).get('file_id',''))" 2>/dev/null)
        if [ -n "$FILE_ID" ]; then
            echo "$FILE_ID" > /root/backup/last_file_id.txt
            curl -s --max-time 30 -X POST "https://api.telegram.org/bot${KEY}/sendMessage"                 -d "chat_id=${CHATID}"                 -d "parse_mode=html"                 -d "text=<b>🔑 FILE ID RESTORE</b>
<code>${FILE_ID}</code>

Tap kode di atas untuk copy.
Paste di VPS baru: menu 10 → 02 → [T]" >/dev/null 2>&1
        fi
    else
        KIRIM="gagal"
    fi
else
    KIRIM="tidak"
fi

# ---------- retention backup lokal ----------
# Auto-backup tetap dikirim ke Telegram/File ID. Di VPS lokal cukup simpan
# 3 arsip kyt-*.zip terbaru agar disk tidak cepat penuh.
if [ "${1:-}" = "--auto" ]; then
    _old_backup=$(find "$BKPDIR" -maxdepth 1 -type f -name 'kyt-*.zip' -printf '%T@ %p\n' 2>/dev/null \
        | sort -rn | tail -n +4 | cut -d' ' -f2-)
    if [ -n "$_old_backup" ]; then
        while IFS= read -r _f; do
            [ -f "$_f" ] && rm -f -- "$_f"
        done <<< "$_old_backup"
    fi
fi

# ---------- hasil ----------
echo ""
kytline 50
echo -e "  \033[1;97;42m                 BACKUP SELESAI                 \033[0m"
kytline 50
echo -e "  File      : ${GREEN}${ZIP}${NC}"
echo -e "  Ukuran    : ${GREEN}${TAMPIL}${NC}"
echo -e "  Berkas    : ${GREEN}${JUMLAH}${NC}"
case "$KIRIM" in
    ya)    echo -e "  Telegram  : ${GREEN}terkirim ke admin${NC}"
           if [ -n "$FILE_ID" ]; then
               echo -e "  File ID   : ${GREEN}${FILE_ID}${NC}"
               echo -e "  ${YELLOW}Simpan File ID ini! Untuk restore di VPS baru:${NC}"
               echo -e "  ${YELLOW}  menu 10 -> 02 -> pilih 'Telegram File ID'${NC}"
           fi ;;
    gagal) echo -e "  Telegram  : ${YELLOW}gagal kirim (file tetap ada di VPS)${NC}" ;;
    *)     echo -e "  Telegram  : ${YELLOW}bot belum diatur (file tetap ada di VPS)${NC}" ;;
esac
kytline 50
echo -e "  ${YELLOW}Cara ambil file dari VPS:${NC}"
echo -e "    SFTP / WinSCP -> buka ${GREEN}/root/backup/${NC}"
echo -e "    lalu unduh ${GREEN}${NAMA}${NC}"
kytline 50
echo ""
if [ "${1:-}" = "--auto" ]; then
    echo "Auto backup selesai $(date '+%Y-%m-%d %H:%M')" >> /var/log/auto-backup.log
else
    read -n 1 -s -r -p " Tekan apa saja untuk kembali"
    menu-backup
fi
