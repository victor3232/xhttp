#!/bin/bash
# Auto Force IPv4
wget() { command wget -4 "$@"; }
curl() { command curl -4 "$@"; }
export -f wget curl 2>/dev/null || true
# ============================================================
#  backup  -  BACKUP DATA VPN KE FILE .ZIP  (tanpa rclone/email)
#
#  Hasil:
#    /root/backup/<host>-backup-<tanggal>.zip
#    + dikirim ke Telegram admin (kalau bot terpasang)
#
#  Isi zip: semua data akun buyer + konfigurasi + sertifikat.
#  geoip.dat / geosite.dat TIDAK ikut (besar, bisa diunduh ulang).
# ============================================================

# ==== GARIS RGB (selaras dengan menu utama) ====
KYTRB=("255;0;0" "255;64;0" "255;128;0" "255;192;0" "255;255;0" "192;255;0" \
"128;255;0" "64;255;0" "0;255;0" "0;255;64" "0;255;128" "0;255;192" \
"0;255;255" "0;192;255" "0;128;255" "0;64;255" "0;0;255" "64;0;255" \
"128;0;255" "192;0;255" "255;0;255" "255;0;192" "255;0;128" "255;0;64")
kytline() {
    local n="${1:-19}" i=0 out="" c
    while [ "$i" -lt "$n" ]; do
        c=${KYTRB[$(( i % ${#KYTRB[@]} ))]}
        out+=$'\033[38;2;'"$c"$'m━'
        i=$((i+1))
    done
    printf '%s\033[0m\n' "$out"
}
# ==== akhir garis RGB ====

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

BKPDIR="/root/backup"
BATAS_FILE=8388608          # 8 MB - file lebih besar dilewati

clear
kytline 50
echo -e "  \033[1;97;42m            BACKUP DATA VPN (.zip)            \033[0m"
kytline 50
echo ""

mkdir -p "$BKPDIR"

HOST=$(hostname 2>/dev/null | tr -cd 'A-Za-z0-9._-')
[ -z "$HOST" ] && HOST=$(curl -s --max-time 8 ipv4.icanhazip.com 2>/dev/null | tr -d '\r\n')
[ -z "$HOST" ] && HOST="vps"
NAMA="kyt-${HOST}-$(date +%Y%m%d-%H%M%S).zip"
ZIP="$BKPDIR/$NAMA"

# ---------- daftar berkas akun & konfigurasi ----------
