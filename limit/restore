ringkas_db() {
    # $1 = path database, $2 = tipe (web|bot)
    [ -f "$1" ] || { echo "belum terpasang"; return 0; }
    python3 - "$1" "$2" 2>/dev/null <<'PY'
import os, sqlite3, sys
path, tipe = sys.argv[1], sys.argv[2]
if not os.path.isfile(path):
    print("belum terpasang")
    sys.exit(0)
try:
    con = sqlite3.connect("file:%s?mode=ro" % path, uri=True, timeout=20)
except Exception as e:
    print("(tidak bisa dibuka: %s)" % e)
    sys.exit(0)

def ada(t):
    return con.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (t,)).fetchone()

def n(t):
    return con.execute('SELECT COUNT(*) FROM "%s"' % t).fetchone()[0] if ada(t) else 0

def s(t, k):
    if not ada(t):
        return 0
    try:
        return con.execute('SELECT COALESCE(SUM("%s"),0) FROM "%s"' % (k, t)).fetchone()[0] or 0
    except Exception:
        return 0

if tipe == "web":
    print("pengguna=%d | akun=%d | invoice=%d | deposit=%d | produk=%d | saldo=Rp%s"
          % (n("users"), n("accounts"), n("orders"), n("deposits"),
             n("premium_products"), format(s("users", "balance_milli") // 1000, ",").replace(",", ".")))
else:
    print("buyer=%d | produk=%d | pesanan=%d | deposit=%d | saldo=Rp%s"
          % (n("store_user"), n("produk"), n("pesanan"), n("deposit"),
             format(s("store_user", "saldo"), ",").replace(",", ".")))
con.close()
PY
}
