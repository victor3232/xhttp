#!/bin/bash
# Auto Force IPv4
wget() { command wget -4 "$@"; }
curl() { command curl -4 "$@"; }
export -f wget curl 2>/dev/null || true
# ============================================================
#  restore  -  RESTORE DATA VPN DARI FILE .ZIP
#
#  Cara pakai:
#    1. Upload file .zip hasil backup ke /root  (SFTP/WinSCP)
#    2. menu 10 -> 02 RESTORE
#    3. Pilih nomor file zip yang tampil
#
#  Pengaman:
#    - zip diperiksa dulu (rusak / bukan backup -> ditolak)
#    - data SEKARANG dicadangkan otomatis sebelum ditimpa
#    - kalau /etc/shadow hasil restore tidak punya root ->
#      DIBATALKAN (biar tidak terkunci dari VPS)
#    - hak akses berkas penting diperbaiki
#    - layanan VPN di-restart otomatis
# ============================================================

# ==== GARIS RGB (selaras dengan menu utama) ====
KYTRB=("255;0;0" "255;64;0" "255;128;0" "255;192;0" "255;255;0" "192;255;0" \
"128;255;0" "64;255;0" "0;255;0" "0;255;64" "0;255;128" "0;255;192" \
"0;255;255" "0;192;255" "0;128;255" "0;64;255" "0;0;255" "64;0;255" \
"128;0;255" "192;0;255" "255;0;255" "255;0;192" "255;0;128" "255;0;64")
kytline() {
    local n="${1:-19}" i=0 out="" c
    while [ "$i" -lt "$n" ]; do
        c=${KYTRB[$(( i % ${#KYTRB[@]} ))]}
        out+=$'\033[38;2;'"$c"$'m━'
        i=$((i+1))
    done
    printf '%s\033[0m\n' "$out"
}
# ==== akhir garis RGB ====

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

clear
kytline 50
echo -e "  \033[1;97;41m            RESTORE DATA VPN (.zip)            \033[0m"
kytline 50
echo ""

# ---------- cari file zip ----------
echo -e " ${CYAN}File .zip yang tersedia (terbaru di atas):${NC}"
echo ""
CANDIDATES=()
while IFS= read -r f; do
    [ -f "$f" ] && CANDIDATES+=("$f")
done < <(find /root /root/backup -maxdepth 1 -type f -name '*.zip' -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-)
i=${#CANDIDATES[@]}

if [ "$i" -eq 0 ]; then
    echo -e "   ${YELLOW}(tidak ada file .zip di /root atau /root/backup)${NC}"
    echo ""
    kytline 50
    echo -e " ${YELLOW}Cara upload:${NC}"
    echo -e "   1. Buka SFTP / WinSCP ke VPS ini"
    echo -e "   2. Masuk folder ${GREEN}/root${NC}"
    echo -e "   3. Upload file .zip hasil backup ke situ"
    echo -e "   4. Jalankan menu ini lagi"
    kytline 50
    echo ""
    echo -e " ${CYAN}[T]${NC} Restore dari Telegram File ID"
    echo ""
    read -rp " Pilih [T] File ID / Enter untuk kembali: " PILIH
    if [[ -z "$PILIH" ]]; then menu-backup; exit 0; fi
else
    for idx in "${!CANDIDATES[@]}"; do
        f="${CANDIDATES[$idx]}"
        n=$((idx + 1))
        UK=$(stat -c%s "$f" 2>/dev/null || echo 0)
        if [ "$UK" -lt 1048576 ]; then
            T="$((UK / 1024)) KB"
        else
            T=$(awk "BEGIN{printf \"%.2f MB\", $UK/1048576}")
        fi
        printf "   [%d] %-42s %8s  %s\n" "$n" "$(basename "$f")" "$T" "$(date -r "$f" '+%d-%m %H:%M' 2>/dev/null)"
    done
    echo ""
    echo -e " ${CYAN}[T]${NC} Restore dari Telegram File ID"
    echo ""
    read -rp " Pilih nomor file / [T] File ID: " PILIH
fi

if [[ "$PILIH" == "t" || "$PILIH" == "T" ]]; then
    KEY=""; CHATID=""
    [ -f /etc/bot/.bot.db ] && {
        KEY=$(grep -E "^#bot# " /etc/bot/.bot.db 2>/dev/null | tail -1 | awk '{print $2}')
        CHATID=$(grep -E "^#bot# " /etc/bot/.bot.db 2>/dev/null | tail -1 | awk '{print $3}')
    }
    if { [ -z "$KEY" ] || [ -z "$CHATID" ]; } && [ -f /usr/bin/kyt/var.txt ]; then
        [ -z "$KEY" ] && KEY=$(sed -n "s/^BOT_TOKEN=//p" /usr/bin/kyt/var.txt 2>/dev/null | tr -d "'\"\r\n ")
        [ -z "$CHATID" ] && CHATID=$(sed -n "s/^ADMIN=//p" /usr/bin/kyt/var.txt 2>/dev/null | tr -d "'\"\r\n ")
    fi
    if [ -z "$KEY" ]; then
        echo -e " ${YELLOW}Bot belum diatur. Masukkan manual:${NC}"
        read -rp " Bot Token: " KEY
        [ -z "$KEY" ] && { echo -e " ${RED}Token kosong.${NC}"; read -n1 -s -rp " Press any key..."; menu-backup; exit 1; }
    fi
    echo ""
    read -rp " Paste File ID: " FIDS
    [ -z "$FIDS" ] && { menu-backup; exit 0; }
    echo -e " ${CYAN}Downloading dari Telegram...${NC}"
    FPATH=$(curl -s "https://api.telegram.org/bot${KEY}/getFile?file_id=${FIDS}" | python3 -c "import sys,json;print(json.load(sys.stdin).get('result',{}).get('file_path',''))" 2>/dev/null)
    if [ -z "$FPATH" ]; then
        echo -e " ${RED}File ID tidak valid atau bot error.${NC}"
        read -n1 -s -rp " Press any key..."; menu-backup; exit 1
    fi
    DLURL="https://api.telegram.org/file/bot${KEY}/${FPATH}"
    DLNAME="/root/backup/restore-$(date +%Y%m%d%H%M%S).zip"
    mkdir -p /root/backup
    if curl -fsSL --max-time 300 "$DLURL" -o "$DLNAME"; then
        echo -e " ${GREEN}Downloaded: $(basename $DLNAME) ($(stat -c%s "$DLNAME" | awk '{printf "%.1f MB",$1/1048576}'))${NC}"
        PILIH="$DLNAME"
    else
        echo -e " ${RED}Download gagal.${NC}"
        read -n1 -s -rp " Press any key..."; menu-backup; exit 1
    fi
fi
[ -z "$PILIH" ] && { menu-backup; exit 0; }

if [ -f "$PILIH" ]; then
    ZIP="$PILIH"
elif [[ "$PILIH" =~ ^[0-9]+$ ]]; then
    ZIP="${CANDIDATES[$((PILIH - 1))]:-}"
else
    ZIP=""
fi

if [ -z "$ZIP" ] || [ ! -f "$ZIP" ]; then
    echo -e " ${RED}File tidak ditemukan.${NC}"
    read -n 1 -s -r -p " Tekan apa saja untuk kembali"
    menu-backup
    exit 1
fi

echo ""
echo -e " ${CYAN}File dipilih:${NC} $ZIP"
echo -e " ${YELLOW}Ketik RESTORE untuk melanjutkan.${NC}"
read -rp " Konfirmasi: " KONFIRMASI
if [ "$KONFIRMASI" != "RESTORE" ]; then
    echo -e " ${YELLOW}Restore dibatalkan. Tidak ada data yang diubah.${NC}"
    menu-backup
    exit 0
fi

# ---------- 1. periksa zip ----------
echo -e " ${CYAN}[1/5]${NC} Memeriksa keutuhan zip..."
if ! unzip -t "$ZIP" >/dev/null 2>&1; then
    echo -e " ${RED}Zip RUSAK / tidak bisa dibuka. Restore dibatalkan.${NC}"
    read -n 1 -s -r -p " Tekan apa saja untuk kembali"
    menu-backup
    exit 1
fi

ISI=$(unzip -l "$ZIP" 2>/dev/null)
PENTING=0
for pola in "etc/passwd" "passwd" "etc/shadow" "shadow" "etc/xray/config.json" "config.json"; do
    echo "$ISI" | grep -q "$pola" && { PENTING=1; break; }
done
if [ "$PENTING" = "0" ]; then
    echo -e " ${RED}Isi zip BUKAN backup VPS (tidak ada passwd/config).${NC}"
    echo -e " ${YELLOW}Restore dibatalkan.${NC}"
    read -n 1 -s -r -p " Tekan apa saja untuk kembali"
    menu-backup
    exit 1
fi
# Tolak zip yang berisi path aneh (zip-slip) sebelum diekstrak.
if unzip -Z1 "$ZIP" 2>/dev/null | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
    echo -e " ${RED}Zip berisi path tidak aman (../ atau absolut). Restore dibatalkan.${NC}"
    read -n 1 -s -r -p " Tekan apa saja untuk kembali"
    menu-backup
    exit 1
fi
echo -e "       -> ${GREEN}zip valid${NC}"

# ---------- 2. cadangkan data sekarang ----------
echo -e " ${CYAN}[2/5]${NC} Mencadangkan data SEKARANG..."
CAD="/root/backup/sebelum-restore-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$CAD"

# Cadangan pengaman seluas data yang akan ditimpa. Kalau restore gagal,
# isi folder ini bisa dikembalikan manual tanpa kehilangan data lama.
for _d in /etc /opt/kyt-web /usr/local/sbin /usr/bin/kyt /root/slowdns \
          /root/akun /root/udp /var/www/html /var/lib/kyt; do
    [ -e "$_d" ] || continue
    mkdir -p "$CAD$(dirname "$_d")" 2>/dev/null
    cp -a "$_d" "$CAD/" 2>/dev/null
done

# Database disalin dengan SQLite backup API (bukan cp mentah) supaya
# cadangan pengaman juga konsisten walau web/bot sedang menulis.
snapshot_cad() {
    local asal="$1" tuj="$2" label="$3"
    [ -f "$asal" ] || return 0
    if command -v python3 >/dev/null 2>&1; then
        mkdir -p "$(dirname "$tuj")" 2>/dev/null
        rm -f "$tuj" "$tuj-wal" "$tuj-shm"
        if python3 - "$asal" "$tuj" "$label" <<'PY'
import sqlite3, sys
src = sqlite3.connect("file:%s?mode=ro" % sys.argv[1], uri=True, timeout=30)
dst = sqlite3.connect(sys.argv[2], timeout=30)
try:
    with dst:
        src.backup(dst)
    dst.execute("PRAGMA journal_mode=DELETE")
    if str(dst.execute("PRAGMA integrity_check").fetchone()[0]).lower() != "ok":
        raise RuntimeError("integrity_check gagal")
finally:
    dst.close()
    src.close()
print("cadangan %s: ok" % sys.argv[3])
PY
        then
            rm -f "$tuj-wal" "$tuj-shm"
            return 0
        fi
        echo -e " ${YELLOW}Peringatan: cadangan database $label gagal, lanjut dengan salinan biasa.${NC}"
    fi
    mkdir -p "$(dirname "$tuj")" 2>/dev/null
    cp -a "$asal" "$tuj" 2>/dev/null
}
snapshot_cad /opt/kyt-web/data/web.db "$CAD/opt/kyt-web/data/web.db" "website"
snapshot_cad /usr/bin/kyt/database.db "$CAD/usr/bin/kyt/database.db" "bot"
echo -e "       -> ${GREEN}${CAD}${NC}"

# ---------- 3. ekstrak ----------
echo -e " ${CYAN}[3/5]${NC} Mengekstrak zip..."
TMP=$(mktemp -d /tmp/kytrestore.XXXXXX)
if ! unzip -oq "$ZIP" -d "$TMP" 2>/dev/null; then
    echo -e " ${RED}Gagal mengekstrak. Restore dibatalkan.${NC}"
    rm -rf "$TMP"
    read -n 1 -s -r -p " Tekan apa saja untuk kembali"
    menu-backup
    exit 1
fi

# tentukan akar isi zip (mendukung 2 gaya: path penuh atau folder "backup/")
AKAR="$TMP"
if [ ! -d "$TMP/etc" ] && [ ! -f "$TMP/passwd" ]; then
    for kandidat in "$TMP/backup" "$TMP"/*; do
        if [ -d "$kandidat" ] && { [ -d "$kandidat/etc" ] || [ -f "$kandidat/passwd" ]; }; then
            AKAR="$kandidat"
            break
        fi
    done
fi

# ---------- 4. anti terkunci: shadow harus punya root ----------
if [ -f "$AKAR/etc/shadow" ]; then
    if ! grep -q "^root:" "$AKAR/etc/shadow" 2>/dev/null; then
        echo -e " ${RED}Zip ini TIDAK berisi user root di shadow.${NC}"
        echo -e " ${YELLOW}Restore dibatalkan (bisa mengunci akses VPS).${NC}"
        rm -rf "$TMP"
        read -n 1 -s -r -p " Tekan apa saja untuk kembali"
        menu-backup
        exit 1
    fi
fi

# ---------- verifikasi manifest SEBELUM menyentuh sistem ----------
verifikasi_backup() {
    # $1 = root hasil ekstrak, $2 = full|db, $3 = path manifest (opsional)
    local root="$1" mode="${2:-full}"
    local man="${3:-$root/kyt-backup-manifest.json}"
    if [ ! -f "$man" ]; then
        echo -e " ${YELLOW}Backup lama (tanpa manifest) - verifikasi checksum dilewati.${NC}"
        return 0
    fi
    python3 - "$root" "$mode" "$man" <<'PY'
import hashlib
import json
import os
import sqlite3
import sys

root, mode, man = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(man, encoding="utf-8") as f:
        data = json.load(f)
except Exception as e:
    print("manifest tidak bisa dibaca: %s" % e)
    sys.exit(1)

err = []

def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for blok in iter(lambda: f.read(1024 * 1024), b""):
            h.update(blok)
    return h.hexdigest()

if mode == "full":
    for rel, info in (data.get("hashes") or {}).items():
        p = os.path.join(root, rel)
        tipe = info.get("type")
        if tipe == "file":
            if not os.path.isfile(p):
                err.append("hilang: %s" % rel)
            elif os.path.getsize(p) != info.get("size"):
                err.append("ukuran berubah: %s" % rel)
            elif sha256(p) != info.get("sha256"):
                err.append("checksum tidak cocok: %s" % rel)
        elif tipe == "symlink":
            if not os.path.islink(p):
                err.append("symlink hilang: %s" % rel)
            elif os.readlink(p) != info.get("target"):
                err.append("target symlink berubah: %s" % rel)
        elif tipe == "error":
            err.append("file gagal dibaca saat backup: %s" % rel)

def cek_db(nama):
    info = data.get(nama)
    if not info:
        return
    p = os.path.join(root, info.get("path", ""))
    if not os.path.isfile(p):
        err.append("%s tidak ada di backup" % nama)
        return
    try:
        con = sqlite3.connect("file:%s?mode=ro" % p, uri=True, timeout=30)
        integ = con.execute("PRAGMA integrity_check").fetchone()
        if not integ or str(integ[0]).lower() != "ok":
            err.append("%s rusak: %s" % (nama, integ))
        for tabel, jumlah in (info.get("counts") or {}).items():
            try:
                sekarang = con.execute(
                    'SELECT COUNT(*) FROM "%s"' % tabel.replace('"', '""')
                ).fetchone()[0]
                if sekarang != jumlah:
                    err.append("%s.%s: backup %s, sekarang %s"
                               % (nama, tabel, jumlah, sekarang))
            except Exception as e:
                err.append("%s.%s tidak bisa dibaca: %s" % (nama, tabel, e))
        con.close()
    except Exception as e:
        err.append("%s tidak bisa dibuka: %s" % (nama, e))
    print("%s: %s" % (nama, json.dumps(info.get("counts") or {}, sort_keys=True)))

cek_db("web_db")
cek_db("bot_db")
if err:
    for e in err[:25]:
        print("  - %s" % e)
    sys.exit(1)
print("manifest cocok: %d file + database utuh" % len(data.get("hashes") or {}))
PY
}

echo -e " ${CYAN}[4/5]${NC} Memeriksa manifest & database ..."
if ! verifikasi_backup "$AKAR" full; then
    echo -e " ${RED}Backup tidak lolos verifikasi. Restore dibatalkan (data lama tidak diubah).${NC}"
    rm -rf "$TMP"
    read -n 1 -s -r -p " Tekan apa saja untuk kembali"
    menu-backup
    exit 1
fi

# ---------- salin ----------
echo -e "       -> menyalin data..."
# Hentikan web & bot agar database tidak berubah saat ditimpa.
for _svc in kyt-web kyt kyt-bot slowdns slowdns-router; do
    systemctl stop "$_svc" >/dev/null 2>&1 || true
done
# WAL/journal lama WAJIB dibuang. Kalau tidak, SQLite bisa memutar ulang
# transaksi lama di atas database hasil restore (data balik/reset/korup).
rm -f /opt/kyt-web/data/web.db-wal /opt/kyt-web/data/web.db-shm /opt/kyt-web/data/web.db-journal
rm -f /usr/bin/kyt/database.db-wal /usr/bin/kyt/database.db-shm /usr/bin/kyt/database.db-journal
DIPULIHKAN=0

salin() {
    # $1 = sumber di dalam AKAR, $2 = tujuan sistem
    local asal="$1" tuj="$2"
    [ -e "$asal" ] || return 0
    mkdir -p "$(dirname "$tuj")" 2>/dev/null
    if [ -d "$asal" ]; then
        mkdir -p "$tuj" 2>/dev/null
        cp -a "$asal/." "$tuj/" 2>/dev/null && DIPULIHKAN=$((DIPULIHKAN + 1))
    else
        cp -a "$asal" "$tuj" 2>/dev/null && DIPULIHKAN=$((DIPULIHKAN + 1))
    fi
}

# --- gaya 1: path penuh (etc/passwd) ---
if [ -d "$AKAR/etc" ]; then
    for x in passwd group shadow gshadow crontab sshd_config ipsec.secrets ipsec.conf; do
        [ -f "$AKAR/etc/$x" ] && salin "$AKAR/etc/$x" "/etc/$x"
    done
    [ -d "$AKAR/etc/xray" ]         && salin "$AKAR/etc/xray"         "/etc/xray"
    [ -d "$AKAR/etc/vmess" ]        && salin "$AKAR/etc/vmess"        "/etc/vmess"
    [ -d "$AKAR/etc/vless" ]        && salin "$AKAR/etc/vless"        "/etc/vless"
    [ -d "$AKAR/etc/trojan" ]       && salin "$AKAR/etc/trojan"       "/etc/trojan"
    [ -d "$AKAR/etc/shadowsocks" ]  && salin "$AKAR/etc/shadowsocks"  "/etc/shadowsocks"
    [ -d "$AKAR/etc/l2tp" ]         && salin "$AKAR/etc/l2tp"         "/etc/l2tp"
    [ -d "$AKAR/etc/xl2tpd" ]       && salin "$AKAR/etc/xl2tpd"       "/etc/xl2tpd"
    [ -d "$AKAR/etc/ipsec.d" ]      && salin "$AKAR/etc/ipsec.d"      "/etc/ipsec.d"
    [ -d "$AKAR/etc/ppp" ]          && salin "$AKAR/etc/ppp"          "/etc/ppp"
    [ -d "$AKAR/etc/openvpn" ]      && salin "$AKAR/etc/openvpn"      "/etc/openvpn"
    [ -d "$AKAR/etc/ssh" ]          && salin "$AKAR/etc/ssh"          "/etc/ssh"
    [ -d "$AKAR/etc/haproxy" ]      && salin "$AKAR/etc/haproxy"      "/etc/haproxy"
    [ -d "$AKAR/etc/nginx" ]        && salin "$AKAR/etc/nginx"        "/etc/nginx"
    [ -d "$AKAR/etc/letsencrypt" ]  && salin "$AKAR/etc/letsencrypt"  "/etc/letsencrypt"
    [ -d "$AKAR/etc/ssl/kyt-web" ]   && salin "$AKAR/etc/ssl/kyt-web"   "/etc/ssl/kyt-web"
    [ -d "$AKAR/etc/default" ]      && salin "$AKAR/etc/default"      "/etc/default"
    [ -f "$AKAR/etc/kyt.txt" ]      && salin "$AKAR/etc/kyt.txt"      "/etc/kyt.txt"
    [ -f "$AKAR/etc/kyt-theme.conf" ] && salin "$AKAR/etc/kyt-theme.conf" "/etc/kyt-theme.conf"
    [ -f "$AKAR/etc/kyt-license.conf" ] && salin "$AKAR/etc/kyt-license.conf" "/etc/kyt-license.conf"
    [ -d "$AKAR/etc/kyt" ]          && salin "$AKAR/etc/kyt"          "/etc/kyt"
    [ -d "$AKAR/etc/limit" ]        && salin "$AKAR/etc/limit"        "/etc/limit"
    [ -d "$AKAR/etc/dropbear" ]     && salin "$AKAR/etc/dropbear"     "/etc/dropbear"
    [ -d "$AKAR/etc/bot" ]          && salin "$AKAR/etc/bot"          "/etc/bot"
    [ -d "$AKAR/etc/cron.d" ]       && salin "$AKAR/etc/cron.d"       "/etc/cron.d"
    [ -f "$AKAR/etc/sysctl.conf" ]  && salin "$AKAR/etc/sysctl.conf"  "/etc/sysctl.conf"
    [ -f "$AKAR/etc/sysctl.d/99-slowdns.conf" ] && salin "$AKAR/etc/sysctl.d/99-slowdns.conf" "/etc/sysctl.d/99-slowdns.conf"
    [ -d "$AKAR/var/spool/cron/crontabs" ] && salin "$AKAR/var/spool/cron/crontabs" "/var/spool/cron/crontabs"
    [ -d "$AKAR/etc/kyt/jeda-mullog" ] && salin "$AKAR/etc/kyt/jeda-mullog" "/etc/kyt/jeda-mullog"
    [ -d "$AKAR/etc/kyt/trial" ] && salin "$AKAR/etc/kyt/trial" "/etc/kyt/trial"
    [ -f "$AKAR/etc/kyt/jeda-mullog.conf" ] && salin "$AKAR/etc/kyt/jeda-mullog.conf" "/etc/kyt/jeda-mullog.conf"
    [ -f "$AKAR/etc/kyt/trial.conf" ] && salin "$AKAR/etc/kyt/trial.conf" "/etc/kyt/trial.conf"
    [ -f "$AKAR/usr/local/sbin/kyt-trial" ] && salin "$AKAR/usr/local/sbin/kyt-trial" "/usr/local/sbin/kyt-trial"
    [ -f "$AKAR/usr/local/sbin/kyt-trial-expire" ] && salin "$AKAR/usr/local/sbin/kyt-trial-expire" "/usr/local/sbin/kyt-trial-expire"
    [ -f "$AKAR/usr/local/sbin/trial" ] && salin "$AKAR/usr/local/sbin/trial" "/usr/local/sbin/trial"
    [ -f "$AKAR/usr/local/sbin/trial-install.sh" ] && salin "$AKAR/usr/local/sbin/trial-install.sh" "/usr/local/sbin/trial-install.sh"
    [ -f "$AKAR/usr/local/sbin/slowdns-router" ] && salin "$AKAR/usr/local/sbin/slowdns-router" "/usr/local/sbin/slowdns-router"
    [ -f "$AKAR/usr/local/sbin/slowdns-rcvbuf" ] && salin "$AKAR/usr/local/sbin/slowdns-rcvbuf" "/usr/local/sbin/slowdns-rcvbuf"
    [ -f "$AKAR/usr/local/sbin/slowdns" ] && salin "$AKAR/usr/local/sbin/slowdns" "/usr/local/sbin/slowdns"
    [ -f "$AKAR/usr/local/sbin/slowdns-mode" ] && salin "$AKAR/usr/local/sbin/slowdns-mode" "/usr/local/sbin/slowdns-mode"
    [ -f "$AKAR/usr/local/sbin/slowdns-info" ] && salin "$AKAR/usr/local/sbin/slowdns-info" "/usr/local/sbin/slowdns-info"
    [ -f "$AKAR/usr/local/sbin/dns" ] && salin "$AKAR/usr/local/sbin/dns" "/usr/local/sbin/dns"
    [ -f "$AKAR/usr/local/sbin/jeda-mullog" ] && salin "$AKAR/usr/local/sbin/jeda-mullog" "/usr/local/sbin/jeda-mullog"
    [ -f "$AKAR/usr/local/sbin/setting-jeda" ] && salin "$AKAR/usr/local/sbin/setting-jeda" "/usr/local/sbin/setting-jeda"
    [ -f "$AKAR/usr/local/sbin/utility" ] && salin "$AKAR/usr/local/sbin/utility" "/usr/local/sbin/utility"
