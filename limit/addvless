checking_sc() {
  # --- ambil file izin, dengan batas waktu (tidak bisa menggantung) ---
  _izin_txt=""
  # Paksa IPv4; sebagian provider memblokir IPv6 dan mirror bisa membalas AKSES DITOLAK.
  if command -v curl >/dev/null 2>&1; then
    _izin_txt=$(curl -4 -fsSL --max-time 15 "$data_ip" 2>/dev/null)
  fi
  if [ -z "$_izin_txt" ] || printf '%s' "$_izin_txt" | grep -q 'AKSES DITOLAK'; then
    if command -v wget >/dev/null 2>&1; then
      _izin_txt=$(wget -4 -q --timeout=15 --tries=2 -O- "$data_ip" 2>/dev/null)
    fi
  fi
  if printf '%s' "$_izin_txt" | grep -q 'AKSES DITOLAK'; then
    _izin_txt=""
  fi

  # --- tidak bisa cek (internet/repo bermasalah) -> JANGAN blokir ---
  if [ -z "$_izin_txt" ]; then
    echo -e "[1;93m────────────────────────────────────────────[0m"
    echo -e "[0;33m  Tidak bisa memeriksa file izin (koneksi/repo).[0m"
    echo -e "[0;33m  Script dilanjutkan.[0m"
    echo -e "[1;93m────────────────────────────────────────────[0m"
    sleep 2
    return 0
  fi

  _useexp=$(echo "$_izin_txt" | grep -w "$ipsaya" | awk '{print $3}' | head -n1)

  # IP terdaftar dan masih berlaku -> lanjut
  if [ -n "$_useexp" ] && [[ ! "$date_list" > "$_useexp" ]]; then
    return 0
  fi

  # --- IP belum terdaftar / kedaluwarsa -> BERHENTI (tidak reboot) ---
  echo -e "[1;93m────────────────────────────────────────────[0m"
  echo -e "[42m          HITS SSH TUNNELING          [0m"
  echo -e "[1;93m────────────────────────────────────────────[0m"
  echo ""
  echo -e "            ${RED}PERMISSION DENIED !${NC}"
  if [ -z "$_useexp" ]; then
    echo -e "   [0;33mIP VPS ini BELUM terdaftar di file izin:[0m"
  else
    echo -e "   [0;33mMasa izin VPS ini sudah BERAKHIR ($_useexp):[0m"
  fi
  echo -e "   [0;33mYour VPS${NC} $ipsaya [0;33mHas been Banned${NC}"
  echo -e "[1;93m────────────────────────────────────────────[0m"
  echo ""
  echo -e "[0;33m  Script dihentikan. VPS TIDAK direboot.[0m"
  echo -e "[0;33m  Tambahkan/perpanjang IP VPS ini di file 'izin'[0m"
  echo -e "[0;33m  pada repo, lalu jalankan lagi scriptnya.[0m"
  echo -e "[0;33m  Format: ### nama 2026-12-31 $ipsaya[0m"
  echo ""
  sleep 4
  exit 1
}
