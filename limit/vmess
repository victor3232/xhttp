#!/bin/bash
# Auto Force IPv4
wget() { command wget -4 "$@"; }
curl() { command curl -4 "$@"; }
export -f wget curl 2>/dev/null || true
function send-log(){
CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" 2>/dev/null | cut -d ' ' -f 3)
KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" 2>/dev/null | cut -d ' ' -f 2)
if [ -z "$KEY" ] || [ -z "$CHATID" ]; then
    [ -f /usr/bin/kyt/var.txt ] && KEY=$(sed -n 's/^BOT_TOKEN=//p' /usr/bin/kyt/var.txt 2>/dev/null | tr -d "'\"\r\n ")
    [ -f /usr/bin/kyt/var.txt ] && CHATID=$(sed -n 's/^ADMIN=//p' /usr/bin/kyt/var.txt 2>/dev/null | tr -d "'\"\r\n ")
fi
[ -n "$KEY" ] && [ -n "$CHATID" ] || return 0
TIME="10"
URL="https://api.telegram.org/bot$KEY/sendMessage"
TEXT="
<code>────────────────────</code>
<b>⚠️NOTIF QUOTA HABIS XRAY VMESS⚠️</b>
<code>────────────────────</code>
<code>Username  : </code><code>$user</code>
<code>limit Quota: </code><code>$total2</code>
<code>Usage     : </code><code>$total</code>
<code>────────────────────</code>
"
curl -s --max-time $TIME -d "chat_id=$CHATID&disable_web_page_preview=1&text=$TEXT&parse_mode=html" $URL >/dev/null
}

function con() {
    local -i bytes=$1;
    if [[ $bytes -lt 1024 ]]; then
        echo "${bytes}B"
    elif [[ $bytes -lt 1048576 ]]; then
        echo "$(( (bytes + 1023)/1024 ))KB"
    elif [[ $bytes -lt 1073741824 ]]; then
        echo "$(( (bytes + 1048575)/1048576 ))MB"
    else
        echo "$(( (bytes + 1073741823)/1073741824 ))GB"
    fi
}


DRY_RUN="${LIMIT_VMESS_DRY_RUN:-0}"
INTERVAL="${LIMIT_VMESS_INTERVAL:-30}"
ONCE="${LIMIT_VMESS_ONCE:-0}"

while true; do
  [ "$ONCE" = "1" ] || sleep "$INTERVAL"
  data=($(grep '^###' /etc/xray/config.json | cut -d ' ' -f2 | sort | uniq))
  if [[ ! -e /etc/limit/vmess ]]; then
    mkdir -p /etc/limit/vmess
  fi

  stats_json=$(timeout 10 xray api statsquery --server=127.0.0.1:10000 -pattern 'user>>>' -reset=false 2>/dev/null)
  stats_file=$(mktemp /tmp/vmess_stats.XXXXXX)
  printf '%s' "$stats_json" | python3 -c '
import sys, json
users = set(sys.argv[1:])
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for item in data.get("stat", []):
    name = item.get("name", "")
    if not name.startswith("user>>>"):
        continue
    parts = name.split(">>>")
    if len(parts) < 4 or parts[1] not in users or parts[3] != "downlink":
        continue
    try:
        value = int(item.get("value", 0))
    except (TypeError, ValueError):
        continue
    if value > 0:
        print("%s\t%d" % (parts[1], value))
' "${data[@]}" > "$stats_file"

  while IFS=$'\t' read -r user downlink; do
    [ -n "$user" ] || continue
    [[ "$downlink" =~ ^[0-9]+$ ]] || continue
    if [ "$DRY_RUN" = "1" ]; then
      echo "would add $user $downlink"
      continue
    fi
    plus2=$(cat /etc/limit/vmess/"${user}" 2>/dev/null)
    [[ "$plus2" =~ ^[0-9]+$ ]] || plus2=0
    echo "$((downlink + plus2))" > /etc/limit/vmess/"${user}"
    timeout 5 xray api stats --server=127.0.0.1:10000 -name "user>>>${user}>>>traffic>>>downlink" -reset >/dev/null 2>&1
  done < "$stats_file"
  rm -f "$stats_file"

  # Check ur Account
  for user in ${data[@]}; do
    if [ -e /etc/vmess/${user} ]; then
      checkLimit=$(cat /etc/vmess/${user})
      if [[ ${#checkLimit} -gt 1 ]]; then
        if [ -e /etc/limit/vmess/${user} ]; then
          Usage=$(cat /etc/limit/vmess/${user})
          total=$(con ${Usage})
          total2=$(con ${checkLimit})
          if [[ ${Usage} -gt ${checkLimit} ]]; then
            if [ "$DRY_RUN" = "1" ]; then
              echo "would disable quota $user usage=$Usage limit=$checkLimit"
            else
              /usr/local/sbin/kyt-account-state expire vmess "$user" "$(date +%F)" >/dev/null 2>&1
              if [ "$?" -eq 0 ]; then
                send-log
                systemctl restart xray >> /dev/null 2>&1
              fi
            fi
          fi
        fi
      fi
    fi
  done
  [ "$ONCE" = "1" ] && exit 0
done
