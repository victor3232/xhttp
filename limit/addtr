kytline() {
    local n="${1:-19}" i=0 out="" c
    while [ "$i" -lt "$n" ]; do
        c=${KYTRB[$(( i % ${#KYTRB[@]} ))]}
        out+=$'\033[38;2;'"$c"$'m━'
        i=$((i+1))
    done
    printf '%s\033[0m\n' "$out"
}
kytrb() {
    local n="${1:-19}" i=0 out="" c
    while [ "$i" -lt "$n" ]; do
        c=${KYTRB[$(( i % ${#KYTRB[@]} ))]}
        out+=$'\033[38;2;'"$c"$'m━'
        i=$((i+1))
    done
    printf '%s\033[0m' "$out"
}
